<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="Workspace" referent="RBX2"><Properties><string name="Name">Workspace</string></Properties><Item class="SpawnLocation" referent="RBX1"><Properties><string name="Name">SpawnLocation</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>0</X><Y>1</Y><Z>20</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>6</X><Y>1</Y><Z>6</Z></Vector3></Properties></Item></Item><Item class="ReplicatedStorage" referent="RBX14"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX13"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX3"><Properties><string name="Name">BusinessDefinitions</string><ProtectedString name="Source"><![CDATA[return {
	pizza_shop = {
		name = "Harbour Pizza",
		maxOpenOrders = 5,
		orderIntervalSeconds = 20,
		orderLifetimeSeconds = 120,
		counterMultiplier = 1.5, -- sale price = item price * multiplier
		deliveryMultiplier = 2.0,
		reputationOnServe = 1,
		reputationOnExpire = -2,
		minCookSeconds = 4,
	},
	-- Phase 5 food businesses, all run by FoodService.
	-- counter = Part name that serves orders; stations = Part name prefix -> appliance type
	-- (e.g. a Part "CafeCoffeeMachine_1"); jobs = jobs that count as staff; menu = recipes customers order.
	cafe = {
		food = true, name = "Harbour Café", counter = "CafeCounter", jobs = { "barista" },
		stations = { CafeCoffeeMachine = "coffee_machine", CafeToaster = "toaster" },
		menu = { "coffee", "tea", "toastie" },
		maxOpenOrders = 4, orderIntervalSeconds = 18, orderLifetimeSeconds = 120,
		counterMultiplier = 1.5, reputationOnServe = 1, reputationOnExpire = -2, minCookSeconds = 2,
	},
	bakery = {
		food = true, name = "Harbour Bakery", counter = "BakeryCounter", jobs = { "baker" },
		stations = { BakeryOven = "bakery_oven" },
		menu = { "bread", "croissant", "cupcake" },
		maxOpenOrders = 4, orderIntervalSeconds = 22, orderLifetimeSeconds = 150,
		counterMultiplier = 1.6, reputationOnServe = 1, reputationOnExpire = -2, minCookSeconds = 3,
	},
	restaurant = {
		food = true, name = "Quayside Restaurant", counter = "RestaurantCounter", jobs = { "chef", "waiter" },
		stations = { RestaurantStove = "stove" },
		menu = { "roast_chicken", "chicken_curry", "vegetable_soup" },
		maxOpenOrders = 5, orderIntervalSeconds = 25, orderLifetimeSeconds = 180,
		counterMultiplier = 1.8, reputationOnServe = 2, reputationOnExpire = -3, minCookSeconds = 5,
	},
	fast_food = {
		food = true, name = "Dockside Burgers", counter = "FastFoodCounter", jobs = { "fast_food_worker" },
		stations = { FastFoodGrill = "grill", FastFoodFryer = "fryer" },
		menu = { "burger", "fries", "nuggets" },
		maxOpenOrders = 6, orderIntervalSeconds = 12, orderLifetimeSeconds = 90,
		counterMultiplier = 1.4, reputationOnServe = 1, reputationOnExpire = -1, minCookSeconds = 2,
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[return {
	DataStoreName = "HarbourlifePlayerData_v1",
	AutosaveSeconds = 120,
	StartingCash = 250,
	StartingBank = 0,
	InventorySlots = 30,
	MaxStack = 99,
	-- XP needed to reach level n+1 is XpBase * n^XpExponent
	XpBase = 100,
	XpExponent = 1.5,
	MaxLevel = 50,
	SkillXpBase = 50,
	MaxSkillLevel = 20,
	InteractCooldown = 0.5,
	FuelPricePerUnit = 1,
	RepairPricePerPoint = 0.5,
	VehicleServiceRange = 40, -- vehicle must be this close to a fuel station
	ExcavatorCooldown = 0.6,
	ExcavatorMaxReach = 40,
	DigRadius = 3.5,
	DumpRadius = 3,
	BucketCapacity = 5,
	ShopRange = 15, -- max studs from a shop counter to buy
	ShopMaxQty = 10,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX5"><Properties><string name="Name">ItemDefinitions</string><ProtectedString name="Source"><![CDATA[-- Server and client read this; only the server may change inventories.
-- price = base price; shops apply their own markup. stack = max held.
local function item(name, price, stack, category) return { name = name, price = price, stack = stack, category = category } end

return {
	-- food & ingredients
	pizza_dough = item("Pizza Dough", 2, 99, "food"),
	tomato_sauce = item("Tomato Sauce", 3, 99, "food"),
	cheese = item("Cheese", 4, 99, "food"),
	pizza = item("Pizza", 12, 10, "food"),
	bread = item("Bread", 3, 20, "food"),
