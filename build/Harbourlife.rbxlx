	lettuce = item("Lettuce", 1, 99, "ingredient"),
	potatoes = item("Potatoes", 1, 99, "ingredient"),
	cooking_oil = item("Cooking Oil", 2, 99, "ingredient"),
	chicken = item("Chicken", 4, 99, "ingredient"),
	vegetables = item("Vegetables", 2, 99, "ingredient"),
	rice = item("Rice", 1, 99, "ingredient"),
	-- food business products (Phase 5)
	coffee = item("Coffee", 6, 10, "food"),
	tea = item("Tea", 4, 10, "food"),
	toastie = item("Cheese Toastie", 7, 10, "food"),
	croissant = item("Croissant", 6, 10, "food"),
	cupcake = item("Cupcake", 8, 10, "food"),
	roast_chicken = item("Roast Chicken Dinner", 18, 5, "food"),
	chicken_curry = item("Chicken Curry", 16, 5, "food"),
	vegetable_soup = item("Vegetable Soup", 11, 5, "food"),
	burger = item("Burger", 9, 10, "food"),
	fries = item("Fries", 5, 10, "food"),
