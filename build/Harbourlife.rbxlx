	tea_leaves = item("Tea Leaves", 1, 99, "ingredient"),
	flour = item("Flour", 1, 99, "ingredient"),
	sugar = item("Sugar", 1, 99, "ingredient"),
	butter = item("Butter", 2, 99, "ingredient"),
	eggs = item("Eggs", 2, 99, "ingredient"),
