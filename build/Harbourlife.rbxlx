	sandals = item("Sandals", 18, 2, "clothing"),
	slippers = item("Slippers", 12, 2, "clothing"),
	silver_ring = item("Silver Ring", 80, 3, "jewellery"),
	gold_necklace = item("Gold Necklace", 250, 2, "jewellery"),
	wristwatch = item("Wristwatch", 150, 2, "jewellery"),
	earrings = item("Earrings", 60, 3, "jewellery"),
	bracelet = item("Bracelet", 90, 3, "jewellery"),
	novel = item("Novel", 8, 10, "books"),
	cookbook = item("Cookbook", 15, 5, "books"),
	comic = item("Comic", 4, 10, "books"),
	fishing_guide = item("Fishing Guide", 12, 5, "books"),
	harbour_history = item("Harbour History", 10, 5, "books"),
	teddy_bear = item("Teddy Bear", 15, 3, "toys"),
	toy_car = item("Toy Car", 10, 5, "toys"),
	board_game = item("Board Game", 25, 3, "toys"),
	kite = item("Kite", 18, 2, "toys"),
	toy_boat = item("Toy Boat", 12, 3, "toys"),
	jigsaw = item("Jigsaw Puzzle", 9, 5, "toys"),
	guitar = item("Guitar", 180, 1, "music"),
	keyboard_instrument = item("Keyboard", 250, 1, "music"),
	ukulele = item("Ukulele", 60, 1, "music"),
	drum_sticks = item("Drum Sticks", 12, 3, "music"),
	vinyl_record = item("Vinyl Record", 20, 10, "music"),
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX6"><Properties><string name="Name">JobDefinitions</string><ProtectedString name="Source"><![CDATA[-- pay = cash per completed task; xp = XP per task; skill = skill trained; minLevel = player level required
return {
	unemployed = { name = "Unemployed", pay = 0, xp = 0, minLevel = 1 },
	pizza_cook = { name = "Pizza Cook", pay = 8, xp = 10, skill = "cooking", minLevel = 1 },
	delivery_driver = { name = "Delivery Driver", pay = 14, xp = 14, skill = "driving", minLevel = 1 },
	barista = { name = "Barista", pay = 6, xp = 8, skill = "cooking", minLevel = 1 },
	baker = { name = "Baker", pay = 8, xp = 10, skill = "cooking", minLevel = 1 },
	fast_food_worker = { name = "Fast Food Worker", pay = 6, xp = 8, skill = "cooking", minLevel = 1 },
	chef = { name = "Chef", pay = 12, xp = 14, skill = "cooking", minLevel = 3 },
	waiter = { name = "Waiter", pay = 7, xp = 8, minLevel = 1 },
	ferry_operator = { name = "Ferry Operator", pay = 40, xp = 30, skill = "seamanship", minLevel = 5 },
	mechanic = { name = "Mechanic", pay = 18, xp = 16, skill = "repair", minLevel = 3 },
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX7"><Properties><string name="Name">MallDefinitions</string><ProtectedString name="Source"><![CDATA[-- Harbour Mall: retail stores only. MallBuilder fits the building to a Part named "MallSite"
-- and the multi-storey car park to a Part named "CarParkSite" (see docs/MallSetup.md).
-- Stores fill units in order: ground floor first (north side west->east, then south side), then level 1.
-- Each store: shop = ShopDefinitions id, colours, floor material, sign font, interior layout and extra features.
local rgb = Color3.fromRGB

return {
	name = "HARBOUR MALL",
	floorHeight = 24, -- per mall level; must be a multiple of carParkDeckHeight so the bridge lines up
	concourseWidth = 48,
	galleryWidth = 12, -- upper-level walkway in front of the stores, either side of the atrium
	unitWidth = 100, -- target store frontage; the real width is fitted to the site
	salesFraction = 0.6, -- front share of each store that is shop floor; the rest is stockroom and staff room
	escalatorSpeed = 8,
	carParkDeckHeight = 12,
	carParkLevels = 4, -- ground + 3 decks
	carParkRampWidth = 28,
	carParkRampDegrees = 7,

	-- look taken from the developer's reference photos: stone cladding, bronze-framed glass entrance towers,
	-- blue LED band, glass skylight over the atrium, glass balustrades, cream marble with dark inlay bands
	structure = {
		exterior = rgb(222, 206, 178), exteriorDark = rgb(196, 178, 150), bronze = rgb(128, 92, 58), led = rgb(40, 110, 255),
		floor = rgb(236, 230, 218), inlay = rgb(70, 66, 62), gallery = rgb(240, 238, 232), ceiling = rgb(248, 247, 243),
		glass = rgb(150, 195, 225), metal = rgb(185, 188, 195), dark = rgb(55, 57, 62), planter = rgb(180, 165, 140),
		leaves = rgb(80, 130, 60), deck = rgb(120, 120, 124), lines = rgb(245, 245, 245),
	},

	stores = {
		-- ground floor: bulky goods and big footprints
		{ shop = "grocery", wall = rgb(236, 244, 232), floor = rgb(210, 214, 206), floorMat = "Marble", accent = rgb(40, 140, 70),
			signColor = rgb(255, 255, 255), font = "GothamBold", layout = "aisles", shelfHeight = 6,
			products = { rgb(230, 80, 60), rgb(250, 200, 60), rgb(120, 190, 80), rgb(240, 140, 50), rgb(200, 60, 90) },
			features = { "produce", "fridges" } },
		{ shop = "hardware", wall = rgb(90, 92, 98), floor = rgb(150, 150, 150), floorMat = "Concrete", accent = rgb(240, 120, 20),
			signColor = rgb(20, 20, 20), font = "SourceSansBold", layout = "aisles", shelfHeight = 9,
			products = { rgb(240, 120, 20), rgb(60, 60, 60), rgb(200, 170, 110), rgb(30, 90, 170), rgb(180, 40, 40) },
			features = { "timber", "shed" } },
		{ shop = "furniture", wall = rgb(238, 228, 212), floor = rgb(150, 105, 70), floorMat = "WoodPlanks", accent = rgb(120, 80, 50),
			signColor = rgb(255, 245, 225), font = "Garamond", layout = "showroom",
			products = { rgb(110, 130, 150), rgb(190, 160, 120), rgb(160, 70, 60), rgb(90, 120, 90), rgb(230, 220, 200) } },
		{ shop = "electronics", wall = rgb(28, 30, 38), floor = rgb(45, 48, 58), floorMat = "SmoothPlastic", accent = rgb(0, 200, 255),
			signColor = rgb(0, 230, 255), font = "Arcade", layout = "tables",
			products = { rgb(20, 20, 24), rgb(200, 200, 210), rgb(0, 160, 255), rgb(255, 60, 120) },
			features = { "tvWall" } },
		{ shop = "pharmacy", wall = rgb(250, 252, 250), floor = rgb(225, 235, 230), floorMat = "Marble", accent = rgb(0, 160, 90),
			signColor = rgb(255, 255, 255), font = "Gotham", layout = "aisles", shelfHeight = 5,
			products = { rgb(255, 255, 255), rgb(120, 200, 230), rgb(250, 160, 180), rgb(0, 160, 90) },
			features = { "dispensary" } },
		{ shop = "sports", wall = rgb(30, 30, 30), floor = rgb(60, 140, 70), floorMat = "Fabric", accent = rgb(220, 30, 40),
			signColor = rgb(255, 255, 255), font = "LuckiestGuy", layout = "racks",
			products = { rgb(220, 30, 40), rgb(255, 255, 255), rgb(30, 90, 200), rgb(255, 210, 0) },
			features = { "ballPyramids", "hoop" } },
		{ shop = "pet_store", wall = rgb(200, 240, 235), floor = rgb(240, 220, 150), floorMat = "Pebble", accent = rgb(0, 150, 150),
			signColor = rgb(255, 230, 80), font = "FredokaOne", layout = "tanks",
			products = { rgb(255, 170, 60), rgb(120, 200, 255), rgb(240, 90, 120), rgb(140, 200, 90) } },
		{ shop = "fishing_shop", wall = rgb(28, 50, 80), floor = rgb(200, 180, 140), floorMat = "WoodPlanks", accent = rgb(230, 190, 120),
			signColor = rgb(28, 50, 80), font = "Bangers", layout = "aisles", shelfHeight = 6,
			products = { rgb(40, 110, 70), rgb(230, 120, 30), rgb(200, 200, 200), rgb(30, 60, 120) },
			features = { "rodWall", "boat" } },
		-- level 1: fashion and specialist
		{ shop = "clothing", wall = rgb(250, 236, 240), floor = rgb(240, 240, 240), floorMat = "Marble", accent = rgb(230, 120, 160),
			signColor = rgb(255, 255, 255), font = "Bodoni", layout = "racks",
			products = { rgb(240, 160, 190), rgb(250, 250, 250), rgb(60, 60, 80), rgb(170, 200, 230), rgb(230, 200, 120) },
			features = { "mannequins", "fittingRooms" } },
		{ shop = "shoes", wall = rgb(235, 220, 195), floor = rgb(120, 80, 55), floorMat = "Wood", accent = rgb(90, 55, 35),
			signColor = rgb(250, 235, 205), font = "Antique", layout = "wallShelves",
			products = { rgb(90, 55, 35), rgb(20, 20, 20), rgb(250, 250, 250), rgb(200, 60, 50) },
			features = { "benches" } },
		{ shop = "jewellery", wall = rgb(20, 20, 22), floor = rgb(30, 30, 32), floorMat = "Marble", accent = rgb(212, 175, 55),
			signColor = rgb(212, 175, 55), font = "Garamond", layout = "cases",
			products = { rgb(212, 175, 55), rgb(220, 220, 230), rgb(200, 30, 60), rgb(80, 160, 255) } },
		{ shop = "books", wall = rgb(110, 30, 40), floor = rgb(110, 75, 50), floorMat = "WoodPlanks", accent = rgb(60, 40, 30),
			signColor = rgb(240, 225, 190), font = "Merriweather", layout = "bookcases",
			products = { rgb(150, 30, 40), rgb(30, 60, 110), rgb(40, 100, 60), rgb(220, 200, 150), rgb(30, 30, 30) },
			features = { "readingArea" } },
		{ shop = "toys", wall = rgb(255, 240, 120), floor = rgb(120, 200, 255), floorMat = "Plastic", accent = rgb(255, 60, 60),
			signColor = rgb(255, 255, 255), font = "FredokaOne", layout = "tables",
			products = { rgb(255, 60, 60), rgb(60, 140, 255), rgb(60, 200, 90), rgb(255, 200, 0), rgb(200, 90, 255) },
			features = { "giantTeddy" } },
		{ shop = "music", wall = rgb(60, 30, 90), floor = rgb(35, 25, 45), floorMat = "WoodPlanks", accent = rgb(200, 90, 255),
			signColor = rgb(240, 200, 255), font = "PermanentMarker", layout = "tables",
			products = { rgb(180, 110, 60), rgb(20, 20, 20), rgb(240, 240, 240), rgb(200, 30, 30) },
			features = { "guitarWall", "stage" } },
		{ shop = "gun_shop", wall = rgb(85, 90, 60), floor = rgb(110, 95, 70), floorMat = "Slate", accent = rgb(190, 160, 100),
			signColor = rgb(230, 210, 160), font = "Oswald", layout = "racks",
			products = { rgb(85, 100, 60), rgb(150, 130, 90), rgb(60, 50, 40), rgb(200, 120, 40) },
			features = { "displayCases" } },
		{ shop = "general_store", wall = rgb(225, 235, 250), floor = rgb(200, 205, 215), floorMat = "SmoothPlastic", accent = rgb(30, 90, 200),
			signColor = rgb(255, 220, 40), font = "GothamBlack", layout = "aisles", shelfHeight = 6,
			products = { rgb(30, 90, 200), rgb(255, 220, 40), rgb(220, 80, 60), rgb(240, 240, 240) } },
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX8"><Properties><string name="Name">RecipeDefinitions</string><ProtectedString name="Source"><![CDATA[-- station = the appliance type that cooks it (see BusinessDefinitions food businesses).
-- cookSeconds is reduced by cooking skill down to the business's minCookSeconds.
return {
	pizza = {
		output = "pizza",
		inputs = { pizza_dough = 1, tomato_sauce = 1, cheese = 1 },
		cookSeconds = 10, -- reduced by cooking skill, see PizzaService
	},
	-- café
	coffee = { output = "coffee", inputs = { coffee_beans = 1, milk = 1 }, cookSeconds = 5, station = "coffee_machine" },
	tea = { output = "tea", inputs = { tea_leaves = 1, milk = 1 }, cookSeconds = 4, station = "coffee_machine" },
	toastie = { output = "toastie", inputs = { bread = 1, cheese = 1, butter = 1 }, cookSeconds = 6, station = "toaster" },
	-- bakery
	bread = { output = "bread", inputs = { flour = 2 }, cookSeconds = 8, station = "bakery_oven" },
	croissant = { output = "croissant", inputs = { flour = 1, butter = 1 }, cookSeconds = 7, station = "bakery_oven" },
	cupcake = { output = "cupcake", inputs = { flour = 1, sugar = 1, eggs = 1 }, cookSeconds = 7, station = "bakery_oven" },
	-- restaurant
	roast_chicken = { output = "roast_chicken", inputs = { chicken = 1, vegetables = 1, potatoes = 1 }, cookSeconds = 14, station = "stove" },
	chicken_curry = { output = "chicken_curry", inputs = { chicken = 1, rice = 1 }, cookSeconds = 12, station = "stove" },
	vegetable_soup = { output = "vegetable_soup", inputs = { vegetables = 2 }, cookSeconds = 9, station = "stove" },
	-- fast food
	burger = { output = "burger", inputs = { beef_patty = 1, burger_bun = 1, lettuce = 1 }, cookSeconds = 6, station = "grill" },
	fries = { output = "fries", inputs = { potatoes = 1, cooking_oil = 1 }, cookSeconds = 5, station = "fryer" },
	nuggets = { output = "nuggets", inputs = { chicken = 1, cooking_oil = 1 }, cookSeconds = 6, station = "fryer" },
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX9"><Properties><string name="Name">Remotes</string><ProtectedString name="Source"><![CDATA[-- Creates (server) or waits for (client) the shared RemoteEvents.
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local NAMES = { "DataChanged", "Notify", "ExcavatorAction", "OpenShop", "ShopBuy" }
local Remotes = {}

local folder
if RunService:IsServer() then
	folder = Instance.new("Folder")
	folder.Name = "Remotes"
	folder.Parent = ReplicatedStorage
	for _, name in NAMES do
		local r = Instance.new("RemoteEvent")
		r.Name = name
		r.Parent = folder
	end
else
	folder = ReplicatedStorage:WaitForChild("Remotes")
end
for _, name in NAMES do
	Remotes[name] = folder:WaitForChild(name)
end
return Remotes
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX10"><Properties><string name="Name">ShopDefinitions</string><ProtectedString name="Source"><![CDATA[-- markup multiplies the item's base price. stock = max units held; restock adds 1 of each item per interval.
-- Any Part named "Shop_<id>" becomes a counter for that shop (several locations may share one id).
return {
	grocery = { name = "Grocery", markup = 1.0, stock = 20, restockSeconds = 30,
		items = { "bread", "milk", "apple", "cheese", "tomato_sauce", "pizza_dough", "water_bottle", "sandwich" } },
	general_store = { name = "General Store", markup = 1.2, stock = 10, restockSeconds = 45,
		items = { "water_bottle", "snack_bar", "torch", "batteries", "fuel_can", "town_map" } },
	clothing = { name = "Clothing Store", markup = 1.0, stock = 6, restockSeconds = 60,
		items = { "tshirt", "jeans", "hoodie", "work_boots", "hi_vis_vest", "cap" } },
	electronics = { name = "Electronics", markup = 1.0, stock = 3, restockSeconds = 120,
		items = { "phone", "radio", "camera", "laptop", "headphones" } },
	hardware = { name = "Hardware Store", markup = 1.0, stock = 10, restockSeconds = 45,
		items = { "hammer", "wrench", "screwdriver", "paint_tin", "rope", "toolbox", "planks", "nails" } },
	fishing_shop = { name = "Fishing Shop", markup = 1.0, stock = 6, restockSeconds = 60,
		items = { "fishing_rod", "bait", "tackle_box", "landing_net", "cool_box" } },
	furniture = { name = "Furniture Store", markup = 1.0, stock = 4, restockSeconds = 90,
		items = { "chair", "table", "sofa", "bed", "lamp", "rug" } },
	pet_store = { name = "Pet Store", markup = 1.0, stock = 8, restockSeconds = 60,
		items = { "pet_food", "pet_bed", "pet_collar", "pet_jumper", "pet_hat", "pet_toy" } },
	gun_shop = { name = "Gun Shop (Clothing & Display)", markup = 1.0, stock = 5, restockSeconds = 60,
		items = { "camo_jacket", "cargo_trousers", "tactical_boots", "range_cap", "ear_defenders", "display_case" } },
	-- Harbour Mall stores (all retail lives in the mall, see MallDefinitions)
	pharmacy = { name = "Pharmacy", markup = 1.0, stock = 15, restockSeconds = 40,
		items = { "plasters", "painkillers", "vitamins", "toothpaste", "shampoo", "sun_cream" } },
	sports = { name = "Sports Store", markup = 1.0, stock = 6, restockSeconds = 60,
		items = { "football", "tennis_racket", "trainers", "gym_bag", "bike_helmet", "swim_goggles" } },
	shoes = { name = "Shoe Shop", markup = 1.0, stock = 6, restockSeconds = 60,
		items = { "trainers", "wellies", "smart_shoes", "sandals", "slippers", "work_boots" } },
	jewellery = { name = "Jewellers", markup = 1.0, stock = 3, restockSeconds = 120,
		items = { "silver_ring", "gold_necklace", "wristwatch", "earrings", "bracelet" } },
	books = { name = "Bookshop", markup = 1.0, stock = 10, restockSeconds = 45,
		items = { "novel", "cookbook", "comic", "fishing_guide", "harbour_history", "town_map" } },
	toys = { name = "Toy Shop", markup = 1.0, stock = 8, restockSeconds = 45,
		items = { "teddy_bear", "toy_car", "board_game", "kite", "toy_boat", "jigsaw" } },
	music = { name = "Music Store", markup = 1.0, stock = 3, restockSeconds = 90,
		items = { "guitar", "keyboard_instrument", "ukulele", "drum_sticks", "vinyl_record", "headphones" } },
	-- trade supplier for the Phase 5 food businesses (no markup)
	food_wholesale = { name = "Food Wholesaler", markup = 1.0, stock = 40, restockSeconds = 15,
		items = { "coffee_beans", "tea_leaves", "milk", "bread", "cheese", "butter", "flour", "sugar", "eggs",
			"chicken", "vegetables", "rice", "potatoes", "beef_patty", "burger_bun", "lettuce", "cooking_oil" } },
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX11"><Properties><string name="Name">SkillDefinitions</string><ProtectedString name="Source"><![CDATA[return {
	cooking = { name = "Cooking" },
	driving = { name = "Driving" },
	seamanship = { name = "Seamanship" },
	repair = { name = "Repair" },
	fishing = { name = "Fishing" },
	construction = { name = "Construction" },
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX12"><Properties><string name="Name">VehicleDefinitions</string><ProtectedString name="Source"><![CDATA[-- price 0 = starter vehicle. size is (width, height, length); the vehicle faces -Z.
return {
	sedan = { name = "Sedan", price = 0, size = Vector3.new(7, 2, 14), color = Color3.fromRGB(60, 100, 200),
		fuelCapacity = 60, fuelPerSecond = 0.15, wearPerSecond = 0.01, maxSpeed = 60, turnRate = 1.6 },
	pickup = { name = "Pickup", price = 1500, size = Vector3.new(8, 3, 16), color = Color3.fromRGB(180, 60, 50),
		fuelCapacity = 80, fuelPerSecond = 0.2, wearPerSecond = 0.012, maxSpeed = 55, turnRate = 1.5 },
	delivery_van = { name = "Delivery Van", price = 2500, size = Vector3.new(8, 4.5, 17), color = Color3.fromRGB(240, 240, 240),
		fuelCapacity = 90, fuelPerSecond = 0.22, wearPerSecond = 0.012, maxSpeed = 50, turnRate = 1.4 },
	excavator = { name = "Excavator", price = 8000, size = Vector3.new(10, 3, 12), color = Color3.fromRGB(240, 190, 30),
		fuelCapacity = 120, fuelPerSecond = 0.3, wearPerSecond = 0.02, maxSpeed = 18, turnRate = 1.0, construction = true },
}
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX33"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX31"><Properties><string name="Name">Systems</string></Properties><Item class="ModuleScript" referent="RBX15"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local Config = require(game.ReplicatedStorage.Shared.Config)
local Remotes = require(game.ReplicatedStorage.Shared.Remotes)

local DataService = {}
-- GetDataStore throws in unpublished places; nil store means "temporary data only".
local storeOk, store = pcall(function() return DataStoreService:GetDataStore(Config.DataStoreName) end)
if not storeOk then
	warn("[Harbourlife] DataStores unavailable (" .. tostring(store) .. "); progress will not save")
	store = nil
end
local profiles: { [Player]: any } = {}
local loadFailed: { [Player]: boolean } = {}

local function defaultData()
	return { cash = Config.StartingCash, bank = Config.StartingBank, inventory = {}, xp = 0, level = 1, skills = {}, job = "unemployed", reputation = 0, vehicles = { sedan = { fuel = 60, condition = 100 } }, version = 1 }
end

local function reconcile(data)
	for k, v in defaultData() do
		if data[k] == nil then data[k] = v end
	end
	return data
end

local function tryAsync(fn, tries)
	for i = 1, tries do
		local ok, res = pcall(fn)
		if ok then return true, res end
		if i < tries then task.wait(2 ^ i) end
	end
	return false
end

function DataService.Get(player: Player)
	return profiles[player]
end

function DataService.Push(player: Player)
	local d = profiles[player]
	if d then Remotes.DataChanged:FireClient(player, { cash = d.cash, bank = d.bank, inventory = d.inventory, xp = d.xp, level = d.level, job = d.job, skills = d.skills, reputation = d.reputation }) end
end

function DataService.Save(player: Player)
	local d = profiles[player]
	if not d or not store or loadFailed[player] then return end -- never overwrite real data after a failed load
	tryAsync(function() store:SetAsync("p_" .. player.UserId, d) end, 3)
end

local function onJoin(player: Player)
	local tries = game:GetService("RunService"):IsStudio() and 1 or 3
	local ok, data = false, nil
	if store then ok, data = tryAsync(function() return store:GetAsync("p_" .. player.UserId) end, tries) end
	if not player.Parent then return end
	if not ok then
		loadFailed[player] = true -- never save over real data we couldn't read
		if game:GetService("RunService"):IsStudio() then
			-- Unpublished place / API access off: play with temporary data instead of kicking.
			warn("[Harbourlife] DataStore unavailable in Studio; using temporary data (nothing will save)")
			profiles[player] = defaultData()
			DataService.Push(player)
			return
		end
		player:Kick("Could not load your data. Rejoin to protect your progress.")
		return
	end
	profiles[player] = reconcile(data or {})
	DataService.Push(player)
end

function DataService.Start()
	Players.PlayerAdded:Connect(onJoin)
	for _, p in Players:GetPlayers() do task.spawn(onJoin, p) end
	Players.PlayerRemoving:Connect(function(p)
		DataService.Save(p)
		profiles[p] = nil
		loadFailed[p] = nil
	end)
	game:BindToClose(function()
		for _, p in Players:GetPlayers() do task.spawn(DataService.Save, p) end
		task.wait(3)
	end)
	task.spawn(function()
		while true do
			task.wait(Config.AutosaveSeconds)
			for _, p in Players:GetPlayers() do task.spawn(DataService.Save, p) end
		end
	end)
end

return DataService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX16"><Properties><string name="Name">EconomyService</string><ProtectedString name="Source"><![CDATA[local DataService = require(script.Parent.DataService)

local Economy = {}

local function valid(n) return type(n) == "number" and n == n and n > 0 and n < 1e9 and n % 1 == 0 end

function Economy.AddCash(player: Player, amount: number): boolean
	local d = DataService.Get(player)
	if not d or not valid(amount) then return false end
	d.cash += amount
	DataService.Push(player)
	return true
end

function Economy.SpendCash(player: Player, amount: number): boolean
	local d = DataService.Get(player)
	if not d or not valid(amount) or d.cash < amount then return false end
	d.cash -= amount
	DataService.Push(player)
	return true
end

function Economy.Deposit(player: Player, amount: number): boolean
	local d = DataService.Get(player)
	if not d or not valid(amount) or d.cash < amount then return false end
	d.cash -= amount; d.bank += amount
	DataService.Push(player)
	return true
end

function Economy.Withdraw(player: Player, amount: number): boolean
	local d = DataService.Get(player)
	if not d or not valid(amount) or d.bank < amount then return false end
	d.bank -= amount; d.cash += amount
	DataService.Push(player)
	return true
end

return Economy
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX17"><Properties><string name="Name">ExcavatorService</string><ProtectedString name="Source"><![CDATA[-- Server-validated digging. The client only asks ("dig" / "dump"); the server checks the
-- driver, cooldown, reach and the real bucket position before editing terrain.
local Config = require(game.ReplicatedStorage.Shared.Config)
local Defs = require(game.ReplicatedStorage.Shared.VehicleDefinitions)
local Remotes = require(game.ReplicatedStorage.Shared.Remotes)
local Vehicle = require(script.Parent.VehicleService)
local Progression = require(script.Parent.ProgressionService)
local Notify = require(script.Parent.NotificationService)

local E = {}
local terrain = workspace.Terrain
local lastAction: { [Player]: number } = {}

-- ReadVoxels returns a 3D array plus a Size field, so index it numerically.
local function hasTerrain(pos: Vector3): boolean
	local region = Region3.new(pos - Vector3.new(2, 2, 2), pos + Vector3.new(2, 2, 2)):ExpandToGrid(4)
	local mats = terrain:ReadVoxels(region, 4)
	local size = mats.Size
	for x = 1, size.X do
		for y = 1, size.Y do
			for z = 1, size.Z do
				local m = mats[x][y][z]
				if m ~= Enum.Material.Air and m ~= Enum.Material.Water then return true end
			end
		end
	end
	return false
end

local function setLoad(a, load)
	a.seat:SetAttribute("Load", load)
	local dirt = a.model:FindFirstChild("BucketDirt")
	if dirt then dirt.Transparency = load > 0 and 0 or 1 end
end

local function puff(tip: Attachment)
	local dust = tip:FindFirstChild("Dust")
	if not dust then return end
	dust.Enabled = true
	task.delay(0.35, function() dust.Enabled = false end)
end

-- Where dumped dirt lands: straight down from the bucket, ignoring the excavator itself.
local function groundBelow(pos: Vector3, model: Model): Vector3
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { model }
	local hit = workspace:Raycast(pos, Vector3.new(0, -60, 0), params)
	return hit and hit.Position or pos
end

local function handle(player: Player, action: any)
	if action ~= "dig" and action ~= "dump" then return end
	local now = os.clock()
	if now - (lastAction[player] or 0) < Config.ExcavatorCooldown then return end
	lastAction[player] = now

	local a = Vehicle.GetActive(player)
	if not a or not Defs[a.id].construction or not a.seat.Occupant then return end
	local bucket = a.model:FindFirstChild("Bucket")
	local tip = bucket and bucket:FindFirstChild("Tip")
	if not tip then return end
	local pos = tip.WorldPosition
	if (pos - a.body.Position).Magnitude > Config.ExcavatorMaxReach then return end

	local load = a.seat:GetAttribute("Load") or 0
	if action == "dig" then
		if load >= Config.BucketCapacity then Notify.Send(player, "Bucket full - dump it first", "error"); return end
		if not hasTerrain(pos) then Notify.Send(player, "Nothing to dig here", "error"); return end
		terrain:FillBall(pos, Config.DigRadius, Enum.Material.Air)
		setLoad(a, load + 1)
		puff(tip)
		Progression.AddSkillXp(player, "construction", 3)
	else
		if load <= 0 then Notify.Send(player, "Bucket is empty", "error"); return end
		terrain:FillBall(groundBelow(pos, a.model), Config.DumpRadius, Enum.Material.Ground)
		setLoad(a, load - 1)
		puff(tip)
		Progression.AddSkillXp(player, "construction", 1)
	end
end

function E.Start()
	Remotes.ExcavatorAction.OnServerEvent:Connect(handle)
	game.Players.PlayerRemoving:Connect(function(p) lastAction[p] = nil end)
end

return E
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX18"><Properties><string name="Name">FoodService</string><ProtectedString name="Source"><![CDATA[-- Food businesses (Phase 5): café, bakery, restaurant, fast food. One data-driven loop for all of them:
-- Food Wholesaler (a shop) -> ingredients -> station cooks a menu recipe -> counter serves a customer order
-- -> payment, job pay, XP, reputation. Definitions live in BusinessDefinitions (entries with food = true).
-- Workspace markers per business, e.g. the café:
--   CafeCounter              serves orders (shows open orders above it)
--   CafeCoffeeMachine_<n>    a station; prefix -> appliance type in the definition
local Players = game:GetService("Players")
local Items = require(game.ReplicatedStorage.Shared.ItemDefinitions)
local Recipes = require(game.ReplicatedStorage.Shared.RecipeDefinitions)
local Businesses = require(game.ReplicatedStorage.Shared.BusinessDefinitions)
local DataService = require(script.Parent.DataService)
local Economy = require(script.Parent.EconomyService)
local Inventory = require(script.Parent.InventoryService)
local Progression = require(script.Parent.ProgressionService)
local JobService = require(script.Parent.JobService)
local Interaction = require(script.Parent.InteractionService)
local Notify = require(script.Parent.NotificationService)

type Order = { id: number, item: string, expires: number }
type Station = { biz: string, kind: string, owner: Player?, recipe: string?, doneAt: number?, ready: boolean }

local F = {}
local foodBiz: { [string]: any } = {}
local orders: { [string]: { Order } } = {}
local stations: { [Instance]: Station } = {}
local boards: { [string]: { TextLabel } } = {}
local nextId = 1

local function isStaff(player: Player, bizId: string): boolean
	local d = DataService.Get(player)
	return d ~= nil and table.find(foodBiz[bizId].jobs, d.job) ~= nil
end

local function staffOf(bizId: string): { Player }
	local list = {}
	for _, p in Players:GetPlayers() do if isStaff(p, bizId) then table.insert(list, p) end end
	return list
end

local function reputationChange(player: Player, delta: number)
	local d = DataService.Get(player)
	if d then d.reputation += delta; DataService.Push(player) end
end

local function refreshBoard(bizId: string)
	local names = {}
	for _, o in orders[bizId] do table.insert(names, Items[o.item].name) end
	local text = #names > 0 and ("Orders: " .. table.concat(names, ", ")) or "No orders"
	for _, label in boards[bizId] or {} do label.Text = text end
end

local function spawnOrder(bizId: string)
	local def = foodBiz[bizId]
	if #orders[bizId] >= def.maxOpenOrders then return end
	local o = { id = nextId, item = def.menu[math.random(#def.menu)], expires = os.clock() + def.orderLifetimeSeconds }
	nextId += 1
	table.insert(orders[bizId], o)
	refreshBoard(bizId)
	for _, p in staffOf(bizId) do Notify.Send(p, def.name .. ": new order, " .. Items[o.item].name, "info") end
end

local function expireOrders(bizId: string)
	local list, changed = orders[bizId], false
	for i = #list, 1, -1 do
		if os.clock() >= list[i].expires then
			local o = table.remove(list, i)
			changed = true
			for _, p in staffOf(bizId) do
				reputationChange(p, foodBiz[bizId].reputationOnExpire)
				Notify.Send(p, Items[o.item].name .. " order expired", "error")
			end
		end
	end
	if changed then refreshBoard(bizId) end
end

local function hasInputs(player: Player, recipeId: string): boolean
	for id, n in Recipes[recipeId].inputs do
		if Inventory.Count(player, id) < n then return false end
	end
	return true
end

-- Recipes this station can make, oldest open order first, then the rest of the menu.
local function candidates(st: Station): { string }
	local list = {}
	local function add(r)
		if Recipes[r].station == st.kind and not table.find(list, r) then table.insert(list, r) end
	end
	for _, o in orders[st.biz] do add(o.item) end
	for _, r in foodBiz[st.biz].menu do add(r) end
	return list
end

local function describeInputs(recipeId: string): string
	local parts = {}
	for id, n in Recipes[recipeId].inputs do table.insert(parts, n .. "x " .. Items[id].name) end
	table.sort(parts)
	return table.concat(parts, " + ")
end

local function resetStation(st: Station)
	st.owner, st.recipe, st.doneAt, st.ready = nil, nil, nil, false
end

local function stationInteract(player: Player, part: Instance)
	local st = stations[part]
	if not DataService.Get(player) then return end
	if st.owner and not st.owner.Parent then resetStation(st) end -- owner left the game
	if st.ready and st.owner == player then
		local out = Recipes[st.recipe].output
		if not Inventory.Add(player, out, 1) then Notify.Send(player, "Inventory full", "error"); return end
		resetStation(st)
		local d = DataService.Get(player)
		if d and table.find(foodBiz[st.biz].jobs, d.job) then JobService.CompleteTask(player, d.job) end
		Notify.Send(player, Items[out].name .. " ready", "success")
	elseif st.owner then
		if st.owner == player then Notify.Send(player, "Still cooking...", "info")
		else Notify.Send(player, "In use by " .. st.owner.Name, "error") end
	else
		local list = candidates(st)
		local pick
		for _, r in list do
			if hasInputs(player, r) then pick = r; break end
		end
		if not pick then
			Notify.Send(player, "Need " .. describeInputs(list[1]) .. " for " .. Items[Recipes[list[1]].output].name .. " (Food Wholesaler)", "error")
			return
		end
		for id, n in Recipes[pick].inputs do Inventory.Remove(player, id, n) end
		local secs = math.max(foodBiz[st.biz].minCookSeconds, Recipes[pick].cookSeconds - Progression.SkillLevel(player, "cooking"))
		st.owner, st.recipe, st.doneAt, st.ready = player, pick, os.clock() + secs, false
		local token = st.doneAt
		task.delay(secs, function()
			if st.owner == player and st.doneAt == token then
				st.ready, st.doneAt = true, nil
				Notify.Send(player, Items[Recipes[pick].output].name .. " is ready to collect", "success")
			end
		end)
		Notify.Send(player, "Making " .. Items[Recipes[pick].output].name .. " (" .. secs .. "s)", "info")
	end
end

-- Serves the oldest order whose item the player is carrying.
local function serve(player: Player, bizId: string)
	if not DataService.Get(player) then return end
	local def = foodBiz[bizId]
	for i, o in orders[bizId] do
		if Inventory.Count(player, o.item) > 0 then
			if not Inventory.Remove(player, o.item, 1) then return end
			table.remove(orders[bizId], i)
			refreshBoard(bizId)
			local price = math.floor(Items[o.item].price * def.counterMultiplier)
			Economy.AddCash(player, price)
			local d = DataService.Get(player)
			if d and table.find(def.jobs, d.job) then JobService.CompleteTask(player, d.job) end
			Progression.AddXp(player, 5)
			reputationChange(player, def.reputationOnServe)
			Notify.Send(player, "Served " .. Items[o.item].name .. ": +$" .. price, "success")
			return
		end
	end
	Notify.Send(player, #orders[bizId] > 0 and "You don't have anything that was ordered" or "No orders right now", "error")
end

local function addBoard(part: BasePart, bizId: string)
	local gui = Instance.new("BillboardGui")
	gui.Name = "OrderBoard"
	gui.Size = UDim2.fromOffset(260, 40)
	gui.StudsOffset = Vector3.new(0, 7, 0)
	gui.MaxDistance = 80
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 0.3
	label.BackgroundColor3 = Color3.new(0, 0, 0)
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextScaled = true
	label.Parent = gui
	boards[bizId] = boards[bizId] or {}
	table.insert(boards[bizId], label)
	refreshBoard(bizId)
end

local function hook(inst: Instance)
	if not inst:IsA("BasePart") then return end
	for bizId, def in foodBiz do
		if inst.Name == def.counter then
			addBoard(inst, bizId)
			Interaction.Register(inst, { action = "Serve order", object = def.name, onTriggered = function(p) serve(p, bizId) end })
			return
		end
		for prefix, kind in def.stations do
			if inst.Name:match("^" .. prefix .. "_%d+$") then
				stations[inst] = { biz = bizId, kind = kind, ready = false }
				Interaction.Register(inst, { action = "Use", object = inst.Name, onTriggered = function(p) stationInteract(p, inst) end })
				return
			end
		end
	end
end

function F.Start()
	for id, def in Businesses do
		if def.food then
			for _, r in def.menu do
				assert(Recipes[r] and Items[Recipes[r].output], "FoodService: bad menu recipe " .. r .. " in " .. id)
				for ing in Recipes[r].inputs do assert(Items[ing], "FoodService: unknown ingredient " .. ing) end
			end
			foodBiz[id] = def
			orders[id] = {}
		end
	end
	for _, d in workspace:GetDescendants() do hook(d) end
	workspace.DescendantAdded:Connect(hook)
	Players.PlayerRemoving:Connect(function(p)
		for _, st in stations do if st.owner == p then resetStation(st) end end
	end)
	for id, def in foodBiz do
		task.spawn(function()
			while true do
				task.wait(def.orderIntervalSeconds)
				expireOrders(id)
				if #staffOf(id) > 0 then spawnOrder(id) end
			end
		end)
	end
end

-- test hooks
function F._orders(bizId: string) return orders[bizId] end

return F
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX19"><Properties><string name="Name">InteractionService</string><ProtectedString name="Source"><![CDATA[-- Single place that turns world objects into interactable prompts.
-- The server owns the ProximityPrompt, so distance is enforced by Roblox and the
-- callback only ever runs on the server, with a per-player cooldown.
local Config = require(game.ReplicatedStorage.Shared.Config)

local I = {}
local last: { [Player]: { [Instance]: number } } = {}

function I.Register(part: BasePart, opts: { action: string, object: string?, distance: number?, onTriggered: (Player) -> () })
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = opts.action
	prompt.ObjectText = opts.object or ""
	prompt.MaxActivationDistance = opts.distance or 8
	prompt.RequiresLineOfSight = false
	prompt.Parent = part
	prompt.Triggered:Connect(function(player)
		local now = os.clock()
		last[player] = last[player] or {}
		if now - (last[player][prompt] or 0) < Config.InteractCooldown then return end
		last[player][prompt] = now
		opts.onTriggered(player)
	end)
	return prompt
end

game.Players.PlayerRemoving:Connect(function(p) last[p] = nil end)

return I
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX20"><Properties><string name="Name">InventoryService</string><ProtectedString name="Source"><![CDATA[local Config = require(game.ReplicatedStorage.Shared.Config)
local Items = require(game.ReplicatedStorage.Shared.ItemDefinitions)
local DataService = require(script.Parent.DataService)
local Economy = require(script.Parent.EconomyService)

local Inventory = {}

local function slotsUsed(inv) local n = 0 for _ in inv do n += 1 end return n end

function Inventory.Count(player, itemId): number
	local d = DataService.Get(player)
	return d and d.inventory[itemId] or 0
end

-- Returns false (and changes nothing) if the item is unknown or the inventory is full.
function Inventory.Add(player, itemId: string, qty: number): boolean
	local d, def = DataService.Get(player), Items[itemId]
	if not d or not def or type(qty) ~= "number" or qty < 1 or qty % 1 ~= 0 then return false end
	local have = d.inventory[itemId] or 0
	if have == 0 and slotsUsed(d.inventory) >= Config.InventorySlots then return false end
	if have + qty > (def.stack or Config.MaxStack) then return false end
	d.inventory[itemId] = have + qty
	DataService.Push(player)
	return true
end

function Inventory.Remove(player, itemId: string, qty: number): boolean
	local d = DataService.Get(player)
	if not d or type(qty) ~= "number" or qty < 1 or qty % 1 ~= 0 then return false end
	local have = d.inventory[itemId] or 0
	if have < qty then return false end
	d.inventory[itemId] = have > qty and have - qty or nil
	DataService.Push(player)
	return true
end

-- Atomic purchase: cash is refunded if the item can't be added.
function Inventory.Buy(player, itemId: string, qty: number): boolean
	local def = Items[itemId]
	if not def or type(qty) ~= "number" or qty < 1 or qty % 1 ~= 0 then return false end
	if not Economy.SpendCash(player, def.price * qty) then return false end
	if not Inventory.Add(player, itemId, qty) then
		Economy.AddCash(player, def.price * qty)
		return false
	end
	return true
end

return Inventory
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX21"><Properties><string name="Name">JobCentre</string><ProtectedString name="Source"><![CDATA[-- Placeholder Job Centre: a pad in Workspace named "JobCentre_<jobId>" becomes a sign-up point.
-- Example: name a Part "JobCentre_pizza_cook". Replace with the real building later.
local Jobs = require(game.ReplicatedStorage.Shared.JobDefinitions)
local Interaction = require(script.Parent.InteractionService)
local JobService = require(script.Parent.JobService)

local C = {}

local function hook(part: Instance)
	if not part:IsA("BasePart") then return end
	local jobId = part.Name:match("^JobCentre_(.+)$")
	if not jobId or not Jobs[jobId] then return end
	Interaction.Register(part, {
		action = "Take job",
		object = Jobs[jobId].name,
		onTriggered = function(player) JobService.SetJob(player, jobId) end,
	})
end

function C.Start()
	for _, d in workspace:GetDescendants() do hook(d) end
	workspace.DescendantAdded:Connect(hook)
end

return C
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX22"><Properties><string name="Name">JobService</string><ProtectedString name="Source"><![CDATA[local Jobs = require(game.ReplicatedStorage.Shared.JobDefinitions)
local DataService = require(script.Parent.DataService)
local Economy = require(script.Parent.EconomyService)
local Progression = require(script.Parent.ProgressionService)
local Notify = require(script.Parent.NotificationService)

local J = {}

function J.SetJob(player: Player, jobId: string): boolean
	local d, def = DataService.Get(player), Jobs[jobId]
	if not d or not def then return false end
	if d.level < def.minLevel then
		Notify.Send(player, "You need level " .. def.minLevel .. " for " .. def.name, "error")
		return false
	end
	d.job = jobId
	DataService.Push(player)
	Notify.Send(player, "You are now: " .. def.name, "success")
	return true
end

-- Called by job systems when a real task finishes (cooked pizza, delivered order, ...).
-- The payout comes from server-side definitions only; callers can't pass amounts.
function J.CompleteTask(player: Player, jobId: string): boolean
	local d, def = DataService.Get(player), Jobs[jobId]
	if not d or not def or d.job ~= jobId or def.pay <= 0 then return false end
	Economy.AddCash(player, def.pay)
	Progression.AddXp(player, def.xp)
	if def.skill then Progression.AddSkillXp(player, def.skill, def.xp) end
	return true
end

return J
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX23"><Properties><string name="Name">MallBuilder</string><ProtectedString name="Source"><![CDATA[-- Builds Harbour Mall on the Part named "MallSite" and the multi-storey car park on "CarParkSite".
-- Two retail levels around a skylit atrium with escalators and glass lifts; every unit is a full store
-- (themed shop floor, till, stockroom with racking, staff room, loading door). See MallDefinitions.
-- MallService runs this at server start when no "HarbourMall" model exists. To bake the mall into the
-- place so it can be edited by hand, run in the Studio command bar (edit mode):
--   require(game.ServerScriptService.Systems.MallBuilder).Build(true)
local CollectionService = game:GetService("CollectionService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Def = require(Shared.MallDefinitions)
local Shops = require(Shared.ShopDefinitions)
local C = Def.structure
local Mat = Enum.Material

local MallBuilder = {}

local GLASS = { Transparency = 0.45, Reflectance = 0.25 }
local CLEAR = { Transparency = 0.7, Reflectance = 0.1 }
local SETBACK = 26 -- gap between the site edge and the building, for canopies, planters and the plaza
local DECOR = { CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false }

--------------------------------------------------------------------------------------------------
-- geometry helpers (all coordinates are local to a frame f)

local function part(parent, name, size, cf, color, mat, props, shape)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat or Mat.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape then p.Shape = shape end
	if props then for k, v in props do (p :: any)[k] = v end end
	p.Parent = parent
	return p
end

local function box(f, parent, name, x0, y0, z0, x1, y1, z1, color, mat, props)
	local sx, sy, sz = math.abs(x1 - x0), math.abs(y1 - y0), math.abs(z1 - z0)
	if sx < 0.05 or sy < 0.05 or sz < 0.05 then return nil end
	return part(parent, name, Vector3.new(sx, sy, sz), f * CFrame.new((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2), color, mat, props)
end

local function ball(f, parent, name, x, y, z, d, color, mat, props)
	return part(parent, name, Vector3.new(d, d, d), f * CFrame.new(x, y, z), color, mat, props or DECOR, Enum.PartType.Ball)
end

-- vertical cylinder standing on y
local function post(f, parent, name, x, y, z, h, d, color, mat, props)
	return part(parent, name, Vector3.new(h, d, d), f * CFrame.new(x, y + h / 2, z) * CFrame.Angles(0, 0, math.pi / 2), color, mat, props, Enum.PartType.Cylinder)
end

local function wedge(f, parent, name, size, lcf, color, mat, props)
	local w = Instance.new("WedgePart")
	w.Name = name; w.Anchored = true; w.Size = size; w.CFrame = f * lcf; w.Color = color; w.Material = mat
	if props then for k, v in props do (w :: any)[k] = v end end
	w.Parent = parent
	return w
end

local function font(name)
	local ok, f = pcall(function() return (Enum.Font :: any)[name] end)
	return ok and f or Enum.Font.GothamBold
end

local function material(name)
	local ok, m = pcall(function() return (Mat :: any)[name] end)
	return ok and m or Mat.SmoothPlastic
end

local function sign(p, face, text, color, fontName, bg)
	local g = Instance.new("SurfaceGui")
	g.Face = face
	g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	g.PixelsPerStud = 25
	g.LightInfluence = 0
	g.MaxDistance = 400
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = bg and 0 or 1
	if bg then t.BackgroundColor3 = bg end
	t.Text = text
	t.TextScaled = true
	t.TextColor3 = color
	t.Font = font(fontName or "GothamBold")
	t.Parent = g
	g.Parent = p
	return g
end

-- Wall along local X from u0 to u1, centred on z = zc with thickness t, with rectangular openings {u0, u1, y0, y1}.
local function wall(f, parent, name, u0, u1, y0, y1, zc, t, openings, color, mat, props)
	local us = { u0, u1 }
	for _, o in openings do
		for _, v in { o[1], o[2] } do if v > u0 and v < u1 then table.insert(us, v) end end
	end
	table.sort(us)
	for i = 1, #us - 1 do
		local a, b = us[i], us[i + 1]
		if b - a > 0.05 then
			local mid = (a + b) / 2
			local cuts = {}
			for _, o in openings do
				if mid > o[1] and mid < o[2] then table.insert(cuts, { math.max(o[3], y0), math.min(o[4], y1) }) end
			end
			table.sort(cuts, function(p, q) return p[1] < q[1] end)
			local y = y0
			for _, c in cuts do
				if c[1] > y then box(f, parent, name, a, y, zc - t / 2, b, c[1], zc + t / 2, color, mat, props) end
				y = math.max(y, c[2])
			end
			if y1 > y then box(f, parent, name, a, y, zc - t / 2, b, y1, zc + t / 2, color, mat, props) end
		end
	end
end

-- Same as wall() but running along local Z at x = xc; openings use z ranges.
local function wallZ(f, parent, name, z0, z1, y0, y1, xc, t, openings, color, mat, props)
	local rf = f * CFrame.new(xc, 0, 0) * CFrame.Angles(0, math.pi / 2, 0) -- local +X of rf is -Z of f
	local ops = {}
	for _, o in openings do table.insert(ops, { -o[2], -o[1], o[3], o[4] }) end
	wall(rf, parent, name, -z1, -z0, y0, y1, 0, t, ops, color, mat, props)
end

-- Horizontal slab with rectangular holes {x0, z0, x1, z1}; solid cells are merged into strips.
local function slab(f, parent, name, x0, z0, x1, z1, y0, y1, holes, color, mat, props)
	local xs, zs = { x0, x1 }, { z0, z1 }
	for _, h in holes do
		for _, v in { h[1], h[3] } do if v > x0 and v < x1 then table.insert(xs, v) end end
		for _, v in { h[2], h[4] } do if v > z0 and v < z1 then table.insert(zs, v) end end
	end
	table.sort(xs); table.sort(zs)
	local function solid(x, z)
		for _, h in holes do
			if x > h[1] and x < h[3] and z > h[2] and z < h[4] then return false end
		end
		return true
	end
	for i = 1, #xs - 1 do
		local a, b = xs[i], xs[i + 1]
		if b - a > 0.05 then
			local runStart
			for j = 1, #zs do
				local c, d = zs[j], zs[j + 1]
				local isSolid = d ~= nil and solid((a + b) / 2, (c + d) / 2)
				if d ~= nil and d - c <= 0.05 then continue end
				if isSolid and not runStart then runStart = c end
				if not isSolid and runStart then
					box(f, parent, name, a, y0, runStart, b, y1, c, color, mat, props)
					runStart = nil
				end
			end
		end
	end
end

-- Sloped slab whose top surface runs from p0 to p1; width is horizontal, across the slope.
local function ramp(f, parent, name, p0: Vector3, p1: Vector3, width, thick, color, mat, props)
	local d = (p1 - p0).Unit
	local across = Vector3.yAxis:Cross(d)
	across = across.Magnitude > 1e-3 and across.Unit or Vector3.xAxis
	local up = d:Cross(across)
	if up.Y < 0 then up = -up end
	local cf = CFrame.fromMatrix((p0 + p1) / 2 - up * thick / 2, across, up)
	return part(parent, name, Vector3.new(width, thick, (p1 - p0).Magnitude), f * cf, color, mat, props), across, up, d
end

-- Glass balustrade with a steel top rail along an axis-aligned line at floor height y.
local function railing(f, parent, x0, z0, x1, z1, y, h)
	h = h or 3.5
	local ax, az = math.min(x0, x1), math.min(z0, z1)
	local bx, bz = math.max(x0, x1), math.max(z0, z1)
	local alongX = (bx - ax) >= (bz - az)
	local hx, hz = alongX and 0 or 0.15, alongX and 0.15 or 0
	box(f, parent, "Railing", ax - hx, y, az - hz, bx + hx, y + h, bz + hz, C.glass, Mat.Glass, CLEAR)
	box(f, parent, "Handrail", ax - hx * 2, y + h, az - hz * 2, bx + hx * 2, y + h + 0.35, bz + hz * 2, C.metal, Mat.Metal)
end

local function tree(f, parent, x, y, z, s)
	post(f, parent, "Trunk", x, y, z, 7 * s, 0.8 * s, Color3.fromRGB(110, 85, 60), Mat.Wood, DECOR)
	ball(f, parent, "Leaves", x, y + 8 * s, z, 6 * s, C.leaves, Mat.Grass)
	ball(f, parent, "Leaves", x + 1.2 * s, y + 10 * s, z - 0.8 * s, 4.5 * s, C.leaves, Mat.Grass)
end

local function planter(f, parent, x, y, z, sx, sz, withTree)
	box(f, parent, "Planter", x - sx / 2, y, z - sz / 2, x + sx / 2, y + 2.5, z + sz / 2, C.planter, Mat.Limestone)
	box(f, parent, "Soil", x - sx / 2 + 0.5, y + 2.5, z - sz / 2 + 0.5, x + sx / 2 - 0.5, y + 2.6, z + sz / 2 - 0.5, Color3.fromRGB(70, 50, 35), Mat.Ground, DECOR)
	if withTree then tree(f, parent, x, y + 2.5, z, 1) end
end

--------------------------------------------------------------------------------------------------
-- store furniture

local function product(fr, m, x0, y0, z0, x1, y1, z1, color)
	return box(fr, m, "Product", x0, y0, z0, x1, y1, z1, color, Mat.SmoothPlastic, DECOR)
end

local function pick(ctx) return ctx.colors[ctx.rng:NextInteger(1, #ctx.colors)] end

-- Shelving unit over [x0,x1]x[z0,z1] (long axis = shelf direction), stocked with product blocks.
local function shelfRun(ctx, x0, z0, x1, z1, h, levels, blockLen, frameColor)
	local fr, m, rng = ctx.fr, ctx.m, ctx.rng
	frameColor = frameColor or C.metal
	box(fr, m, "Shelf", x0, 0, z0, x1, 0.5, z1, frameColor, Mat.Metal)
	local alongX = (x1 - x0) > (z1 - z0)
	if alongX then
		local zm = (z0 + z1) / 2
		box(fr, m, "Shelf", x0, 0.5, zm - 0.2, x1, h, zm + 0.2, frameColor, Mat.Metal)
	else
		local xm = (x0 + x1) / 2
		box(fr, m, "Shelf", xm - 0.2, 0.5, z0, xm + 0.2, h, z1, frameColor, Mat.Metal)
	end
	local gap = (h - 1) / levels
	for l = 1, levels do
		local y = 0.5 + (l - 1) * gap
		if l > 1 then box(fr, m, "Shelf", x0, y - 0.15, z0, x1, y, z1, frameColor, Mat.Metal) end
		local a0, a1 = alongX and x0 or z0, alongX and x1 or z1
		local a = a0 + 0.3
		while a < a1 - 1 do
			local len = math.min(blockLen * (0.6 + rng:NextNumber() * 0.8), a1 - 0.3 - a)
			local ph = math.min(gap - 0.4, 0.8 + rng:NextNumber() * 1.2)
			if alongX then product(fr, m, a, y, z0 + 0.2, a + len, y + ph, z1 - 0.2, pick(ctx))
			else product(fr, m, x0 + 0.2, y, a, x1 - 0.2, y + ph, a + len, pick(ctx)) end
			a += len + 0.4
		end
	end
end

local function wallShelf(ctx, side, z0, z1, h, levels)
	local x = side < 0 and ctx.wx0 or ctx.wx1 - 2.5
	shelfRun(ctx, x, z0, x + 2.5, z1, h or 8, levels or 4, 5, ctx.def.accent)
end

local function clothesRail(ctx, x, z, len)
	local fr, m = ctx.fr, ctx.m
	for _, dx in { -len / 2, len / 2 } do post(fr, m, "RailPost", x + dx, 0, z, 5.6, 0.3, C.metal, Mat.Metal) end
	box(fr, m, "Rail", x - len / 2, 5.4, z - 0.1, x + len / 2, 5.6, z + 0.1, C.metal, Mat.Metal, DECOR)
	local n = math.floor(len / 3)
	for i = 1, n do
		local gx = x - len / 2 + (i - 0.5) * len / n
		box(fr, m, "Garment", gx - 0.35, 2.2, z - 1.2, gx + 0.35, 5.3, z + 1.2, pick(ctx), Mat.Fabric, DECOR)
	end
end

local function mannequin(ctx, x, z)
	local fr, m = ctx.fr, ctx.m
	post(fr, m, "Mannequin", x, 0, z, 0.3, 2.2, C.dark, Mat.Metal, DECOR)
	box(fr, m, "Mannequin", x - 0.5, 0.3, z - 0.4, x + 0.5, 3.4, z + 0.4, Color3.fromRGB(235, 235, 235), Mat.SmoothPlastic, DECOR)
	box(fr, m, "Outfit", x - 1, 3.4, z - 0.55, x + 1, 6, z + 0.55, pick(ctx), Mat.Fabric, DECOR)
	ball(fr, m, "Mannequin", x, 6.8, z, 1.3, Color3.fromRGB(235, 235, 235), Mat.SmoothPlastic)
end

local function displayTable(ctx, x, z, w, d)
	local fr, m, rng = ctx.fr, ctx.m, ctx.rng
	box(fr, m, "Table", x - w / 2 + 0.6, 0, z - d / 2 + 0.6, x + w / 2 - 0.6, 2.6, z + d / 2 - 0.6, ctx.def.wall, Mat.SmoothPlastic)
	box(fr, m, "TableTop", x - w / 2, 2.6, z - d / 2, x + w / 2, 3, z + d / 2, ctx.def.accent, Mat.SmoothPlastic)
	for i = 1, 4 do
		local px = x - w / 2 + (i - 0.5) * w / 4
		local s = 0.8 + rng:NextNumber() * 1.2
		product(fr, m, px - s / 2, 3, z - s / 2, px + s / 2, 3 + 0.3 + rng:NextNumber() * 1.5, z + s / 2, pick(ctx))
	end
end

local function glassCase(ctx, x0, z0, x1, z1)
	local fr, m, rng = ctx.fr, ctx.m, ctx.rng
	box(fr, m, "Case", x0, 0, z0, x1, 3, z1, ctx.def.wall, Mat.SmoothPlastic)
	box(fr, m, "CaseLight", x0 + 0.2, 3, z0 + 0.2, x1 - 0.2, 3.1, z1 - 0.2, Color3.fromRGB(250, 245, 230), Mat.Neon, DECOR)
	box(fr, m, "CaseGlass", x0, 3.1, z0, x1, 4.6, z1, C.glass, Mat.Glass, CLEAR)
	local alongX = (x1 - x0) > (z1 - z0)
	local len = alongX and (x1 - x0) or (z1 - z0)
	for i = 1, math.floor(len / 2) do
		local t = (i - 0.5) / math.floor(len / 2)
		local px = alongX and (x0 + t * (x1 - x0)) or (x0 + x1) / 2
		local pz = alongX and (z0 + z1) / 2 or (z0 + t * (z1 - z0))
		ball(fr, m, "Item", px, 3.5, pz, 0.4 + rng:NextNumber() * 0.4, pick(ctx), Mat.Neon)
	end
end

local function sofa(ctx, x, z, color)
	local fr, m = ctx.fr, ctx.m
	box(fr, m, "Sofa", x - 5, 0, z - 2, x + 5, 1.8, z + 2, color, Mat.Fabric)
	box(fr, m, "Sofa", x - 5, 1.8, z + 1, x + 5, 4, z + 2, color, Mat.Fabric)
	for _, s in { -1, 1 } do box(fr, m, "Sofa", x + s * 4.4 - 0.6, 1.8, z - 2, x + s * 4.4 + 0.6, 2.8, z + 2, color, Mat.Fabric) end
end

local function vignette(ctx, kind, x, z)
	local fr, m = ctx.fr, ctx.m
	local wood = Color3.fromRGB(150, 110, 70)
	box(fr, m, "Rug", x - 10, 0.06, z - 9, x + 10, 0.12, z + 9, pick(ctx), Mat.Fabric, DECOR)
	if kind == 1 then
		sofa(ctx, x, z + 4, pick(ctx))
		box(fr, m, "CoffeeTable", x - 3, 0, z - 4, x + 3, 1.6, z - 1, wood, Mat.Wood)
		post(fr, m, "Lamp", x + 8, 0, z + 5, 6, 0.3, C.dark, Mat.Metal)
		post(fr, m, "LampShade", x + 8, 6, z + 5, 1.6, 1.6, Color3.fromRGB(250, 240, 210), Mat.Fabric, DECOR)
	elseif kind == 2 then
		box(fr, m, "Bed", x - 4.5, 0, z - 5, x + 4.5, 1.6, z + 6, wood, Mat.Wood)
		box(fr, m, "Mattress", x - 4.2, 1.6, z - 4.8, x + 4.2, 2.6, z + 5.8, Color3.fromRGB(245, 245, 245), Mat.Fabric)
		box(fr, m, "Duvet", x - 4.3, 2.6, z - 4.9, x + 4.3, 2.9, z + 2, pick(ctx), Mat.Fabric, DECOR)
		box(fr, m, "Headboard", x - 4.5, 0, z + 6, x + 4.5, 5, z + 6.6, wood, Mat.Wood)
		for _, s in { -1, 1 } do box(fr, m, "Bedside", x + s * 6.5 - 1, 0, z + 4, x + s * 6.5 + 1, 2.2, z + 6, wood, Mat.Wood) end
	elseif kind == 3 then
		box(fr, m, "DiningTable", x - 4, 2.6, z - 2.5, x + 4, 3, z + 2.5, wood, Mat.Wood)
		box(fr, m, "DiningTable", x - 3.5, 0, z - 2, x + 3.5, 2.6, z + 2, C.dark, Mat.Metal)
		for _, cx in { -2.2, 2.2 } do
			for _, s in { -1, 1 } do
				local cz = z + s * 3.6
				box(fr, m, "Chair", x + cx - 0.9, 0, cz - 0.9, x + cx + 0.9, 1.8, cz + 0.9, pick(ctx), Mat.Fabric)
				box(fr, m, "Chair", x + cx - 0.9, 1.8, cz + s * 0.7 - 0.2, x + cx + 0.9, 4, cz + s * 0.7 + 0.2, pick(ctx), Mat.Fabric)
			end
		end
	else
		box(fr, m, "Desk", x - 4, 2.6, z - 2, x + 4, 3, z + 2, wood, Mat.Wood)
		box(fr, m, "Desk", x - 4, 0, z - 2, x - 3.4, 2.6, z + 2, wood, Mat.Wood)
		box(fr, m, "Desk", x + 3.4, 0, z - 2, x + 4, 2.6, z + 2, wood, Mat.Wood)
		box(fr, m, "Bookcase", x - 6, 0, z + 5, x + 6, 8, z + 6.5, wood, Mat.Wood)
		box(fr, m, "Chair", x - 1, 0, z - 4, x + 1, 2, z - 2, pick(ctx), Mat.Fabric)
	end
end

local function tank(ctx, x0, z0, x1, z1)
	local fr, m, rng = ctx.fr, ctx.m, ctx.rng
	box(fr, m, "TankStand", x0, 0, z0, x1, 3, z1, C.dark, Mat.Wood)
	box(fr, m, "Water", x0 + 0.2, 3, z0 + 0.2, x1 - 0.2, 7.5, z1 - 0.2, Color3.fromRGB(60, 150, 230), Mat.Glass, { Transparency = 0.5, CanCollide = false })
	box(fr, m, "Tank", x0, 3, z0, x1, 8, z1, C.glass, Mat.Glass, { Transparency = 0.8 })
	for _ = 1, 3 do
		ball(fr, m, "Fish", x0 + 0.6 + rng:NextNumber() * (x1 - x0 - 1.2), 4 + rng:NextNumber() * 3, z0 + 0.6 + rng:NextNumber() * (z1 - z0 - 1.2), 0.5, pick(ctx), Mat.Neon)
	end
end

local function sideScreens(ctx, side, z0, z1, kind)
	local fr, m = ctx.fr, ctx.m
	local x = side < 0 and ctx.wx0 or ctx.wx1
	local inward = -side
	for z = z0 + 4, z1 - 4, 8 do
		for row = 0, 1 do
			local y = 6 + row * 5
			if kind == "tv" then
				box(fr, m, "TV", x, y, z - 3, x + inward * 0.4, y + 3.6, z + 3, C.dark, Mat.SmoothPlastic, DECOR)
				box(fr, m, "Screen", x + inward * 0.4, y + 0.2, z - 2.8, x + inward * 0.45, y + 3.4, z + 2.8, pick(ctx), Mat.Neon, DECOR)
			else -- guitar
				local col = pick(ctx)
				part(m, "Guitar", Vector3.new(0.5, 2.6, 2.6), fr * CFrame.new(x + inward * 0.6, y, z), col, Mat.Wood, DECOR, Enum.PartType.Cylinder)
				box(fr, m, "Neck", x + inward * 0.5, y + 1.2, z - 0.2, x + inward * 0.75, y + 4.5, z + 0.2, C.dark, Mat.Wood, DECOR)
			end
		end
	end
end

--------------------------------------------------------------------------------------------------
-- store layouts and features. ctx.x0..x1 / z0..z1 is the open shop floor behind the till zone.

local Layouts = {}

function Layouts.aisles(ctx)
	local h = ctx.def.shelfHeight or 6
	for x = ctx.x0 + 8, ctx.x1 - 6, 13 do
		shelfRun(ctx, x - 1.5, ctx.z0 + 2, x + 1.5, ctx.z1 - 10, h, h >= 8 and 4 or 3, 7)
		box(ctx.fr, ctx.m, "EndCap", x - 1.8, 0, ctx.z0, x + 1.8, 3.5, ctx.z0 + 2, ctx.def.accent, Mat.SmoothPlastic)
	end
	wallShelf(ctx, -1, ctx.z0, ctx.z1, h + 2)
	if not ctx.rightWallUsed then wallShelf(ctx, 1, ctx.z0, ctx.z1, h + 2) end
end

function Layouts.bookcases(ctx)
	local wood = ctx.def.accent
	for x = ctx.x0 + 10, ctx.x1 - 6, 12 do
		shelfRun(ctx, x - 1.5, ctx.z0 + 14, x + 1.5, ctx.z1 - 6, 9, 4, 6, wood)
	end
	wallShelf(ctx, -1, ctx.z0, ctx.z1, 12, 5)
	wallShelf(ctx, 1, ctx.z0, ctx.z1, 12, 5)
	for x = ctx.x0 + 10, ctx.x1 - 10, 18 do displayTable(ctx, x, ctx.z0 + 6, 10, 5) end
end

function Layouts.racks(ctx)
	for z = ctx.z0 + 6, ctx.z1 - 6, 11 do
		for x = ctx.x0 + 10, ctx.x1 - 10, 19 do clothesRail(ctx, x, z, 12) end
	end
	wallShelf(ctx, -1, ctx.z0, ctx.z1, 9, 4)
	if not ctx.rightWallUsed then wallShelf(ctx, 1, ctx.z0, ctx.z1, 9, 4) end
end

function Layouts.tables(ctx)
	for z = ctx.z0 + 6, ctx.z1 - 6, 14 do
		for x = ctx.x0 + 10, ctx.x1 - 10, 18 do displayTable(ctx, x, z, 10, 5) end
	end
	if not ctx.leftWallUsed then wallShelf(ctx, -1, ctx.z0, ctx.z1, 8, 4) end
	if not ctx.rightWallUsed then wallShelf(ctx, 1, ctx.z0, ctx.z1, 8, 4) end
end

function Layouts.showroom(ctx)
	local kind = 0
	for z = ctx.z0 + 10, ctx.z1 - 10, 24 do
		for x = ctx.x0 + 12, ctx.x1 - 12, 26 do
			kind = kind % 4 + 1
			vignette(ctx, kind, x, z)
		end
	end
end

function Layouts.tanks(ctx)
	for _, side in { -1, 1 } do
		local x = side < 0 and ctx.wx0 or ctx.wx1 - 4
		for z = ctx.z0, ctx.z1 - 9, 10 do tank(ctx, x, z, x + 4, z + 9) end
	end
	local fr, m = ctx.fr, ctx.m
	for i, x in { ctx.x0 + 18, ctx.x1 - 18 } do
		local z = ctx.z0 + 8
		for _, e in { { -6, -0.2, 6, 0.2 }, { -6, 11.8, 6, 12.2 }, { -6.2, 0, -5.8, 12 }, { 5.8, 0, 6.2, 12 } } do
			box(fr, m, "PenFence", x + e[1], 0, z + e[2], x + e[3], 2.5, z + e[4], ctx.def.accent, Mat.Wood)
		end
		box(fr, m, "Straw", x - 5.8, 0.06, z + 0.2, x + 5.8, 0.3, z + 11.8, Color3.fromRGB(220, 190, 110), Mat.Grass, DECOR)
		box(fr, m, "PetBed", x - 2, 0.3, z + 4 + i, x + 2, 1, z + 7 + i, pick(ctx), Mat.Fabric, DECOR)
	end
	for x = ctx.x0 + 12, ctx.x1 - 12, 14 do shelfRun(ctx, x - 1.5, ctx.z0 + 26, x + 1.5, ctx.z1 - 8, 5, 3, 5) end
end

function Layouts.wallShelves(ctx)
	wallShelf(ctx, -1, ctx.z0, ctx.z1, 10, 6)
	wallShelf(ctx, 1, ctx.z0, ctx.z1, 10, 6)
	for z = ctx.z0 + 8, ctx.z1 - 8, 16 do
		for x = ctx.x0 + 14, ctx.x1 - 14, 22 do displayTable(ctx, x, z, 12, 4) end
	end
end

function Layouts.cases(ctx)
	for z = ctx.z0 + 2, ctx.z1 - 10, 12 do
		glassCase(ctx, ctx.wx0 + 1, z, ctx.wx0 + 4, z + 9)
		glassCase(ctx, ctx.wx1 - 4, z, ctx.wx1 - 1, z + 9)
	end
	for z = ctx.z0 + 8, ctx.z1 - 10, 18 do
		for x = ctx.x0 + 16, ctx.x1 - 16, 24 do
			glassCase(ctx, x - 6, z, x + 6, z + 3)
			glassCase(ctx, x - 6, z + 3, x - 3, z + 9)
		end
	end
	for x = ctx.x0 + 16, ctx.x1 - 16, 24 do -- chandeliers
		for i = 0, 4 do ball(ctx.fr, ctx.m, "Chandelier", x + math.cos(i) * 1.5, ctx.hc - 3 - (i % 2), ctx.z0 + 20 + math.sin(i) * 1.5, 0.9, Color3.fromRGB(255, 240, 200), Mat.Neon) end
	end
end

local Features = {}

function Features.produce(ctx)
	for i = 0, 3 do
		local x = ctx.wx0 + 6 + i * 9
		box(ctx.fr, ctx.m, "ProduceStand", x, 0, 6, x + 7, 2.5, 14, Color3.fromRGB(150, 110, 70), Mat.WoodPlanks)
		box(ctx.fr, ctx.m, "Produce", x + 0.4, 2.5, 6.4, x + 6.6, 3.3, 13.6, pick(ctx), Mat.Grass, DECOR)
	end
end

function Features.fridges(ctx)
	ctx.rightWallUsed = true
	local x = ctx.wx1 - 3
	shelfRun(ctx, x, ctx.z0, x + 3, ctx.z1, 8, 4, 4, Color3.fromRGB(240, 240, 240))
	box(ctx.fr, ctx.m, "FridgeGlass", x - 0.3, 0.5, ctx.z0, x, 8, ctx.z1, C.glass, Mat.Glass, CLEAR)
	box(ctx.fr, ctx.m, "FridgeLight", x - 0.4, 8, ctx.z0, x + 3, 8.4, ctx.z1, Color3.fromRGB(120, 200, 255), Mat.Neon, DECOR)
end

function Features.timber(ctx)
	ctx.rightWallUsed = true
	for i = 0, 3 do
		box(ctx.fr, ctx.m, "Timber", ctx.wx1 - 5, i * 1.2, ctx.z0, ctx.wx1 - 1, i * 1.2 + 1, ctx.z1, Color3.fromRGB(205, 170, 120), Mat.WoodPlanks)
	end
end

function Features.shed(ctx)
	local x, z = ctx.wx0 + 10, 12
	box(ctx.fr, ctx.m, "Shed", x - 5, 0, z - 4, x + 5, 7, z + 4, Color3.fromRGB(140, 100, 60), Mat.WoodPlanks)
	box(ctx.fr, ctx.m, "ShedRoof", x - 6, 7, z - 5, x + 6, 7.8, z + 5, Color3.fromRGB(60, 60, 60), Mat.Slate)
	box(ctx.fr, ctx.m, "ShedDoor", x - 1.5, 0, z - 4.2, x + 1.5, 6, z - 4, Color3.fromRGB(100, 70, 40), Mat.Wood, DECOR)
end

function Features.dispensary(ctx)
	local z = ctx.z1 - 4
	box(ctx.fr, ctx.m, "Dispensary", -14, 0, z, 14, 4, z + 3, Color3.fromRGB(250, 250, 250), Mat.SmoothPlastic)
	box(ctx.fr, ctx.m, "Cross", -0.8, 9, ctx.sd - 0.8, 0.8, 15, ctx.sd - 0.5, ctx.def.accent, Mat.Neon, DECOR)
	box(ctx.fr, ctx.m, "Cross", -3, 11.2, ctx.sd - 0.8, 3, 12.8, ctx.sd - 0.5, ctx.def.accent, Mat.Neon, DECOR)
end

function Features.rodWall(ctx)
	ctx.rightWallUsed = true
	local x = ctx.wx1 - 1.2
	for z = ctx.z0, ctx.z0 + 50, 1.4 do post(ctx.fr, ctx.m, "Rod", x, 1, z, 10, 0.25, pick(ctx), Mat.SmoothPlastic, DECOR) end
	box(ctx.fr, ctx.m, "RodRack", x - 0.6, 0, ctx.z0 - 1, x + 0.6, 1, ctx.z0 + 51, C.dark, Mat.Wood)
end

function Features.boat(ctx)
	local x, z = ctx.wx0 + 14, 12
	box(ctx.fr, ctx.m, "BoatPlinth", x - 9, 0, z - 4, x + 9, 1, z + 4, C.dark, Mat.Wood)
	box(ctx.fr, ctx.m, "BoatHull", x - 6, 1, z - 2.5, x + 6, 3.5, z + 2.5, Color3.fromRGB(245, 245, 245), Mat.SmoothPlastic)
	wedge(ctx.fr, ctx.m, "BoatBow", Vector3.new(5, 2.5, 3), CFrame.new(x + 7.5, 2.25, z) * CFrame.Angles(0, math.pi / 2, 0), Color3.fromRGB(245, 245, 245), Mat.SmoothPlastic)
	box(ctx.fr, ctx.m, "BoatStripe", x - 6, 2.6, z - 2.6, x + 6, 3, z + 2.6, ctx.def.accent, Mat.SmoothPlastic, DECOR)
end

function Features.mannequins(ctx)
	for _, x in { -ctx.uw / 2 + 6, -ctx.uw / 2 + 12, ctx.uw / 2 - 12, ctx.uw / 2 - 6 } do mannequin(ctx, x, 3) end
end

function Features.fittingRooms(ctx)
	local z1 = ctx.sd - 0.5
	for i = 0, 3 do
		local x = ctx.wx0 + 4 + i * 6
		box(ctx.fr, ctx.m, "FittingWall", x, 0, z1 - 7, x + 0.3, 8, z1, ctx.def.wall, Mat.SmoothPlastic)
		box(ctx.fr, ctx.m, "Curtain", x + 0.3, 0.5, z1 - 7, x + 6, 7.5, z1 - 6.8, ctx.def.accent, Mat.Fabric, DECOR)
	end
end

function Features.ballPyramids(ctx)
	for p = 0, 1 do
		local bx = ctx.wx0 + 8 + p * 12
		for layer = 0, 2 do
			local n = 3 - layer
			for i = 0, n - 1 do
				for j = 0, n - 1 do
					ball(ctx.fr, ctx.m, "Ball", bx + (i - (n - 1) / 2) * 1.6, 0.8 + layer * 1.3, 12 + (j - (n - 1) / 2) * 1.6, 1.6, pick(ctx), Mat.SmoothPlastic)
				end
			end
		end
	end
end

function Features.hoop(ctx)
	local x, z = ctx.x0 + 4, ctx.z1 - 2
	post(ctx.fr, ctx.m, "HoopPole", x, 0, z, 12, 0.5, C.dark, Mat.Metal)
	box(ctx.fr, ctx.m, "Backboard", x - 3, 10, z - 1, x + 3, 14, z - 0.7, Color3.fromRGB(250, 250, 250), Mat.SmoothPlastic)
	for _, e in { { -1, -3.2, 1, -3 }, { -1, -1.2, 1, -1 }, { -1.1, -3.2, -0.9, -1 }, { 0.9, -3.2, 1.1, -1 } } do
		box(ctx.fr, ctx.m, "Rim", x + e[1], 10.8, z + e[2], x + e[3], 11, z + e[4], Color3.fromRGB(240, 100, 20), Mat.Metal, DECOR)
	end
end

function Features.displayCases(ctx)
	for i = 0, 2 do glassCase(ctx, ctx.wx0 + 4 + i * 9, 6, ctx.wx0 + 11 + i * 9, 9) end
end

function Features.tvWall(ctx)
	ctx.leftWallUsed, ctx.rightWallUsed = true, true
	sideScreens(ctx, -1, ctx.z0, ctx.z1, "tv")
	sideScreens(ctx, 1, ctx.z0, ctx.z1, "tv")
end

function Features.guitarWall(ctx)
	ctx.leftWallUsed = true
	sideScreens(ctx, -1, ctx.z0, ctx.z1, "guitar")
end

function Features.stage(ctx)
	local x, z = ctx.wx0 + 14, 12
	box(ctx.fr, ctx.m, "Stage", x - 10, 0, z - 5, x + 10, 1.5, z + 5, C.dark, Mat.WoodPlanks)
	for _, s in { -1, 1 } do box(ctx.fr, ctx.m, "Speaker", x + s * 8 - 1.5, 1.5, z, x + s * 8 + 1.5, 7, z + 2.5, C.dark, Mat.Fabric) end
	post(ctx.fr, ctx.m, "Drum", x, 1.5, z + 1, 1.6, 3, ctx.def.accent, Mat.SmoothPlastic)
	post(ctx.fr, ctx.m, "Drum", x - 2.5, 1.5, z + 1.5, 2.4, 1.8, ctx.def.accent, Mat.SmoothPlastic)
	post(ctx.fr, ctx.m, "Cymbal", x + 2.5, 1.5, z + 2, 5, 0.2, C.metal, Mat.Metal)
end

function Features.benches(ctx)
	for i = 0, 2 do
		local x = ctx.wx0 + 6 + i * 12
		box(ctx.fr, ctx.m, "Bench", x, 0, 8, x + 8, 1.8, 10.5, ctx.def.accent, Mat.Fabric)
		box(ctx.fr, ctx.m, "Mirror", x + 2, 0, 12.5, x + 6, 6, 12.8, C.glass, Mat.Glass, { Reflectance = 0.6 })
	end
end

function Features.giantTeddy(ctx)
	local x, z, brown = ctx.wx0 + 10, 10, Color3.fromRGB(160, 110, 60)
	ball(ctx.fr, ctx.m, "Teddy", x, 4, z, 8, brown, Mat.Fabric, {})
	ball(ctx.fr, ctx.m, "Teddy", x, 10, z, 6, brown, Mat.Fabric)
	for _, s in { -1, 1 } do
		ball(ctx.fr, ctx.m, "TeddyEar", x + s * 2.4, 12.6, z, 2.2, brown, Mat.Fabric)
		ball(ctx.fr, ctx.m, "TeddyArm", x + s * 4.2, 5.5, z - 1, 3, brown, Mat.Fabric)
		ball(ctx.fr, ctx.m, "TeddyLeg", x + s * 2.2, 1.4, z - 2.5, 3.2, brown, Mat.Fabric)
	end
	ball(ctx.fr, ctx.m, "TeddyNose", x, 9.8, z - 2.8, 1.2, Color3.fromRGB(40, 30, 20), Mat.SmoothPlastic)
end

function Features.readingArea(ctx)
	local x, z = ctx.wx0 + 14, 12
	box(ctx.fr, ctx.m, "Rug", x - 10, 0.06, z - 6, x + 10, 0.12, z + 6, Color3.fromRGB(120, 40, 40), Mat.Fabric, DECOR)
	for _, s in { -1, 1 } do
		box(ctx.fr, ctx.m, "Armchair", x + s * 5 - 2, 0, z - 2, x + s * 5 + 2, 2, z + 2, Color3.fromRGB(60, 90, 60), Mat.Fabric)
		box(ctx.fr, ctx.m, "Armchair", x + s * 5 - 2, 2, z + 1.4, x + s * 5 + 2, 4.5, z + 2, Color3.fromRGB(60, 90, 60), Mat.Fabric)
	end
	box(ctx.fr, ctx.m, "CoffeeTable", x - 1.5, 0, z - 1.5, x + 1.5, 1.6, z + 1.5, ctx.def.accent, Mat.Wood)
end

--------------------------------------------------------------------------------------------------
-- a store unit: frame fr has origin at the shopfront centre on the floor, +Z pointing into the store

local function hashSeed(s)
	local h = 7
	for i = 1, #s do h = (h * 31 + s:byte(i)) % 2147483647 end
	return h
end

local function buildStore(parent, fr, uw, ud, hc, def, groundFloor)
	local shopDef = def and Shops[def.shop]
	local m = Instance.new("Model")
	m.Name = shopDef and def.shop or "VacantUnit"
	local wallColor = def and def.wall or Color3.fromRGB(235, 235, 235)
	local hw = uw / 2

	-- shell: side walls, floor, ceiling, pilasters between units
	box(fr, m, "Wall", -hw, 0, 0, -hw + 1, hc, ud, wallColor, Mat.SmoothPlastic)
	box(fr, m, "Wall", hw - 1, 0, 0, hw, hc, ud, wallColor, Mat.SmoothPlastic)
	box(fr, m, "Pilaster", -hw, 0, -0.8, -hw + 1.5, hc, 0, C.gallery, Mat.Marble)
	box(fr, m, "Pilaster", hw - 1.5, 0, -0.8, hw, hc, 0, C.gallery, Mat.Marble)
	box(fr, m, "Ceiling", -hw + 1, hc - 0.3, 0, hw - 1, hc, ud, C.ceiling, Mat.SmoothPlastic)

	if not shopDef then -- vacant: hoarding across the front
		box(fr, m, "Hoarding", -hw + 1, 0, 0, hw - 1, hc, 0.6, Color3.fromRGB(245, 245, 245), Mat.SmoothPlastic)
		local s = box(fr, m, "HoardingSign", -hw / 2, 6, -0.2, hw / 2, 12, 0, C.bronze, Mat.SmoothPlastic, DECOR)
		sign(s, Enum.NormalId.Front, "NEW STORE COMING SOON", Color3.new(1, 1, 1), "GothamBold")
		m.Parent = parent
		return m
	end

	local floorMat = material(def.floorMat)
	box(fr, m, "Floor", -hw + 1, 0, 0, hw - 1, 0.06, ud, def.floor, floorMat)

	-- shopfront: glass with a central entrance, LED strip and the store's own fascia sign
	local doorH = 14
	wall(fr, m, "Shopfront", -hw + 1, hw - 1, 0, doorH, 0.2, 0.4, { { -8, 8, 0, doorH } }, C.glass, Mat.Glass, GLASS)
	for x = -hw + 1 + 10, hw - 11, 10 do
		if math.abs(x) > 8.5 then box(fr, m, "Mullion", x - 0.2, 0, -0.1, x + 0.2, doorH, 0.5, C.dark, Mat.Metal) end
	end
	for _, x in { -8, 8 } do box(fr, m, "DoorFrame", x - 0.4, 0, -0.2, x + 0.4, doorH, 0.6, def.accent, Mat.Metal) end
	box(fr, m, "Fascia", -hw + 1, doorH, -0.3, hw - 1, hc, 0.6, def.wall, Mat.SmoothPlastic)
	box(fr, m, "FasciaLED", -hw + 1, doorH, -0.6, hw - 1, doorH + 0.4, -0.3, def.accent, Mat.Neon, DECOR)
	local sg = box(fr, m, "StoreSign", -hw * 0.55, doorH + 1.6, -1, hw * 0.55, hc - 1.6, -0.3, def.accent, Mat.SmoothPlastic, DECOR)
	sign(sg, Enum.NormalId.Front, string.upper(shopDef.name), def.signColor, def.font)
	box(fr, m, "Entrance", -8, 0.06, -2, 8, 0.1, 3, C.dark, Mat.Fabric, DECOR)

	local sd = math.floor(ud * Def.salesFraction)
	local rng = Random.new(hashSeed(def.shop))
	local ctx = {
		fr = fr, m = m, def = def, rng = rng, colors = def.products, uw = uw, ud = ud, hc = hc, sd = sd,
		wx0 = -hw + 1, wx1 = hw - 1, -- inner faces of the side walls
		x0 = -hw + 6, x1 = hw - 6, z0 = 26, z1 = sd - 8,
	}

	-- till: the counter Part is what ShopService turns into the Browse prompt
	local till = box(fr, m, "Shop_" .. def.shop, hw - 30, 0, 12, hw - 10, 4, 15, def.accent, Mat.SmoothPlastic)
	till:SetAttribute("Till", true)
	box(fr, m, "CounterTop", hw - 30.3, 4, 11.7, hw - 9.7, 4.3, 15.3, Color3.fromRGB(245, 245, 245), Mat.Marble, DECOR)
	for _, x in { hw - 26, hw - 16 } do
		box(fr, m, "TillScreen", x - 1, 4.3, 13, x + 1, 6, 13.3, C.dark, Mat.SmoothPlastic, DECOR)
		box(fr, m, "TillScreen", x - 0.9, 4.4, 12.95, x + 0.9, 5.9, 13, Color3.fromRGB(120, 220, 255), Mat.Neon, DECOR)
	end
	shelfRun(ctx, hw - 30, 21, hw - 4, 23, 7, 3, 4, def.accent) -- behind-the-till stock
	local tillSign = box(fr, m, "TillSign", hw - 26, hc - 5, 13.4, hw - 14, hc - 2.5, 13.6, def.accent, Mat.SmoothPlastic, DECOR)
	sign(tillSign, Enum.NormalId.Front, "PAY HERE", def.signColor, def.font)
	box(fr, m, "TillHanger", hw - 20.1, hc - 2.5, 13.45, hw - 19.9, hc, 13.55, C.metal, Mat.Metal, DECOR)

	for _, feat in def.features or {} do
		if Features[feat] then Features[feat](ctx) else warn("[MallBuilder] unknown feature " .. feat) end
	end
	local layout = Layouts[def.layout] or Layouts.aisles
	layout(ctx)

	-- lighting: neon ceiling panels with a couple of real lights
	local lit = 0
	for z = 10, sd - 6, 20 do
		for x = -hw + 12, hw - 12, 22 do
			local panel = box(fr, m, "CeilingLight", x - 4, hc - 0.6, z - 1, x + 4, hc - 0.3, z + 1, Color3.fromRGB(255, 250, 240), Mat.Neon, DECOR)
			if lit < 2 and z > 20 and x > -hw + 20 then
				lit += 1
				local l = Instance.new("SurfaceLight")
				l.Face = Enum.NormalId.Bottom; l.Range = 45; l.Angle = 150; l.Brightness = 1.2; l.Shadows = false
				l.Parent = panel
			end
		end
	end
	box(fr, m, "AccentStrip", -hw + 1, hc - 1.4, 2, -hw + 1.2, hc - 1, sd, def.accent, Mat.Neon, DECOR)
	box(fr, m, "AccentStrip", hw - 1.2, hc - 1.4, 2, hw - 1, hc - 1, sd, def.accent, Mat.Neon, DECOR)

	-- back of house: partition with staff door, stockroom racking, staff room, loading door
	wall(fr, m, "Partition", -hw + 1, hw - 1, 0, hc, sd, 1, { { hw - 16, hw - 8, 0, 10 } }, def.wall, Mat.SmoothPlastic)
	local staffSign = box(fr, m, "StaffOnly", hw - 16, 10.4, sd - 0.7, hw - 8, 12.4, sd - 0.5, C.dark, Mat.SmoothPlastic, DECOR)
	sign(staffSign, Enum.NormalId.Front, "STAFF ONLY", Color3.new(1, 1, 1), "GothamBold")
	box(fr, m, "StockFloor", -hw + 1, 0.06, sd + 0.5, hw - 1, 0.1, ud, Color3.fromRGB(160, 160, 160), Mat.Concrete, DECOR)

	local staffX1, staffZ0 = -hw + 26, ud - 22
	local upright, beam, cardboard = Color3.fromRGB(40, 70, 140), Color3.fromRGB(235, 120, 30), Color3.fromRGB(190, 150, 100)
	for z = sd + 8, ud - 6, 16 do
		local x0 = (z + 4 > staffZ0) and staffX1 + 4 or -hw + 4
		local x1 = hw - 4
		for x = x0, x1, 14 do box(fr, m, "Racking", x - 0.2, 0, z - 2, x + 0.2, 15, z + 2, upright, Mat.Metal) end
		for _, y in { 0.3, 5.5, 10.5 } do
			box(fr, m, "RackBeam", x0, y, z - 2, x1, y + 0.4, z + 2, beam, Mat.Metal)
			for x = x0 + 1, x1 - 13, 14 do
				if rng:NextNumber() < 0.8 then
					local c = cardboard:Lerp(Color3.fromRGB(150, 110, 70), rng:NextNumber())
					box(fr, m, "Stock", x, y + 0.4, z - 1.6, x + 11.5, y + 0.4 + 2.5 + rng:NextNumber() * 1.5, z + 1.6, c, Mat.Cardboard, DECOR)
				end
			end
		end
	end
	wall(fr, m, "StaffRoomWall", -hw + 1, staffX1, 0, hc, staffZ0, 0.6, { { staffX1 - 8, staffX1 - 3, 0, 9 } }, def.wall, Mat.SmoothPlastic)
	box(fr, m, "StaffRoomWall", staffX1, 0, staffZ0, staffX1 + 0.6, hc, ud, def.wall, Mat.SmoothPlastic)
	local srSign = box(fr, m, "StaffRoomSign", staffX1 - 8, 9.4, staffZ0 - 0.4, staffX1 - 3, 10.8, staffZ0 - 0.3, C.dark, Mat.SmoothPlastic, DECOR)
	sign(srSign, Enum.NormalId.Front, "STAFF ROOM", Color3.new(1, 1, 1), "Gotham")
	local tx, tz = -hw + 12, ud - 11
	box(fr, m, "StaffTable", tx - 3, 2.6, tz - 2, tx + 3, 3, tz + 2, Color3.fromRGB(230, 230, 230), Mat.SmoothPlastic)
	box(fr, m, "StaffTable", tx - 0.4, 0, tz - 0.4, tx + 0.4, 2.6, tz + 0.4, C.dark, Mat.Metal)
	for _, o in { { -4.2, 0 }, { 4.2, 0 }, { 0, -3.4 }, { 0, 3.4 } } do
		box(fr, m, "StaffChair", tx + o[1] - 0.9, 0, tz + o[2] - 0.9, tx + o[1] + 0.9, 1.8, tz + o[2] + 0.9, def.accent, Mat.SmoothPlastic)
	end
	for i = 0, 5 do
		box(fr, m, "Locker", -hw + 2 + i * 2.2, 0, ud - 1.6, -hw + 4 + i * 2.2, 7, ud - 0.1, Color3.fromRGB(90, 110, 130), Mat.Metal)
	end
	box(fr, m, "Kitchenette", staffX1 - 9, 0, ud - 2.5, staffX1 - 1, 3.6, ud - 0.1, Color3.fromRGB(240, 240, 240), Mat.SmoothPlastic)

	-- loading door to the service yard (ground floor); named so delivery jobs can find it later
	local ld = box(fr, m, "LoadingDoor_" .. def.shop, hw - 20, 0, ud - 0.3, hw - 6, 12, ud, Color3.fromRGB(150, 155, 160), Mat.DiamondPlate)
	ld:SetAttribute("Shop", def.shop)
	if not groundFloor then ld.Name = "GoodsLift_" .. def.shop end

	m.Parent = parent
	return m
end

--------------------------------------------------------------------------------------------------
-- lifts and escalators (MallService gives them their behaviour at runtime)

local function buildElevator(E, parent, name, floors)
	local m = Instance.new("Model")
	m.Name = name
	local top = floors[#floors] + 11
	box(E, m, "Shaft", -5, floors[1] - 3, 4.6, 5, top, 5, C.glass, Mat.Glass, GLASS)
	box(E, m, "Shaft", -5, floors[1] - 3, -5, -4.6, top, 4.6, C.glass, Mat.Glass, GLASS)
	box(E, m, "Shaft", 4.6, floors[1] - 3, -5, 5, top, 4.6, C.glass, Mat.Glass, GLASS)
	local ops = {}
	for _, fy in floors do table.insert(ops, { -3.5, 3.5, fy, fy + 9 }) end
	wall(E, m, "Shaft", -5, 5, floors[1] - 3, top, -4.8, 0.4, ops, C.glass, Mat.Glass, GLASS)
	for _, c in { { -5, -5 }, { 5, -5 }, { -5, 5 }, { 5, 5 } } do
		box(E, m, "ShaftFrame", c[1] - 0.4, floors[1] - 3, c[2] - 0.4, c[1] + 0.4, top, c[2] + 0.4, C.metal, Mat.Metal)
	end
	box(E, m, "ShaftRoof", -5.4, top, -5.4, 5.4, top + 1, 5.4, C.metal, Mat.Metal)
	box(E, m, "Pit", -4.6, floors[1] - 3, -4.6, 4.6, floors[1] - 2, 4.6, C.dark, Mat.Concrete)
	local offsets = {}
	for i, fy in floors do
		table.insert(offsets, tostring(fy - floors[1]))
		box(E, m, "Gate_" .. i, -3.5, fy, -5, 3.5, fy + 9, -4.6, Color3.fromRGB(200, 220, 235), Mat.Glass, { Transparency = 0.55 })
		local call = box(E, m, "Call_" .. i, 4.2, fy + 4, -5.7, 5.2, fy + 5.4, -5.1, C.dark, Mat.SmoothPlastic)
		sign(call, Enum.NormalId.Front, "CALL", Color3.fromRGB(120, 220, 255), "GothamBold")
		local cd = Instance.new("ClickDetector"); cd.MaxActivationDistance = 14; cd.Parent = call
	end
	local carCF = E * CFrame.new(0, floors[1] - 0.5, 0)
	local car = part(m, "Car", Vector3.new(9, 1, 9), carCF, C.metal, Mat.DiamondPlate, { Anchored = false })
	local function attach(p)
		p.Anchored = false; p.Massless = true
		local w = Instance.new("WeldConstraint"); w.Part0 = car; w.Part1 = p; w.Parent = p
	end
	attach(box(E, m, "CarWall", -4.5, floors[1], 3.9, 4.5, floors[1] + 9, 4.3, C.glass, Mat.Glass, GLASS))
	attach(box(E, m, "CarRail", -4.5, floors[1] + 3, 3.4, 4.5, floors[1] + 3.3, 3.8, C.metal, Mat.Metal))
	attach(box(E, m, "CarCeiling", -4.5, floors[1] + 9, -4.5, 4.5, floors[1] + 9.3, 4.5, C.ceiling, Mat.SmoothPlastic))
	for i = 1, #floors do
		local x = -3.6 + (i - 1) * 1.5
		local b = box(E, m, "Floor_" .. i, x - 0.6, floors[1] + 4, 3.6, x + 0.6, floors[1] + 5.2, 3.9, C.dark, Mat.SmoothPlastic)
		sign(b, Enum.NormalId.Front, i == 1 and "G" or tostring(i - 1), Color3.fromRGB(120, 220, 255), "GothamBold")
		local cd = Instance.new("ClickDetector"); cd.MaxActivationDistance = 12; cd.Parent = b
		attach(b)
	end
	local rail = part(m, "Rail", Vector3.new(1, 1, 1), carCF, C.dark, Mat.SmoothPlastic, { Transparency = 1, CanCollide = false, CanQuery = false })
	local a0 = Instance.new("Attachment"); a0.Axis = Vector3.yAxis; a0.SecondaryAxis = Vector3.xAxis; a0.Parent = rail
	local a1 = Instance.new("Attachment"); a1.Axis = Vector3.yAxis; a1.SecondaryAxis = Vector3.xAxis; a1.Parent = car
	local lift = Instance.new("PrismaticConstraint")
	lift.Name = "Lift"
	lift.Attachment0 = a0; lift.Attachment1 = a1
	lift.ActuatorType = Enum.ActuatorType.Servo
	lift.ServoMaxForce = 1e8; lift.Speed = 10
	lift.LimitsEnabled = true; lift.LowerLimit = 0; lift.UpperLimit = floors[#floors] - floors[1]
	lift.TargetPosition = 0
	lift.Parent = m
	m:SetAttribute("Stops", table.concat(offsets, ","))
	CollectionService:AddTag(m, "HarbourElevator")
	m.Parent = parent
	return m
end

local function buildEscalator(f, parent, bottom: Vector3, top: Vector3, up: boolean)
	local m = Instance.new("Model")
	m.Name = up and "EscalatorUp" or "EscalatorDown"
	local steps, across, normal, d = ramp(f, m, "Steps", bottom, top, 7, 1, Color3.fromRGB(80, 82, 88), Mat.DiamondPlate)
	steps:SetAttribute("Conveyor", f:VectorToWorldSpace(d) * (up and Def.escalatorSpeed or -Def.escalatorSpeed))
	CollectionService:AddTag(steps, "HarbourEscalator")
	ramp(f, m, "Truss", bottom - normal * 1, top - normal * 1, 8, 2.5, C.metal, Mat.Metal)
	for _, s in { -1, 1 } do
		local off = across * s * 3.85
		ramp(f, m, "Balustrade", bottom + off + normal * 3.5, top + off + normal * 3.5, 0.3, 3.5, C.glass, Mat.Glass, CLEAR)
		ramp(f, m, "Handrail", bottom + off + normal * 3.9, top + off + normal * 3.9, 0.5, 0.4, Color3.fromRGB(20, 20, 20), Mat.Rubber)
	end
	for _, p in { bottom, top } do
		part(m, "CombPlate", Vector3.new(8, 0.1, 2), f * CFrame.new(p) * CFrame.fromMatrix(Vector3.zero, across, Vector3.yAxis), C.metal, Mat.DiamondPlate, DECOR)
	end
	m.Parent = parent
	return m
end

--------------------------------------------------------------------------------------------------
-- the mall building

-- W x D is the whole site; the building is set back so canopies, planters and the plaza stay on the site.
local function buildMall(M, siteW, siteD, root)
	local W, D = siteW - 2 * SETBACK, siteD - 2 * SETBACK
	local H, CW, G = Def.floorHeight, Def.concourseWidth, Def.galleryWidth
	local VW, T, ST = CW - 2 * G, 2, 1.5
	local hc = H - ST
	local structure = Instance.new("Folder"); structure.Name = "Structure"; structure.Parent = root
	local storesFolder = Instance.new("Folder"); storesFolder.Name = "Stores"; storesFolder.Parent = root
	local moving = Instance.new("Folder"); moving.Name = "Transport"; moving.Parent = root

	local R = H / math.tan(math.rad(30)) -- escalator run
	local VL = math.min(W / 2 - 30, 6 + R + 70)
	local hasAtrium = VL > 6 + R + 8
	local voids = hasAtrium and { { 6, -VW / 2, VL, VW / 2 }, { -VL, -VW / 2, -6, VW / 2 } } or {}
	local zN = CW / 2 + 14
	local shafts = { { -5, zN - 5, 5, zN + 5 }, { -5, -zN - 5, 5, -zN + 5 } }

	-- plaza around the building, floors, slabs and roof with skylight
	box(M, structure, "Plaza", -siteW / 2, -0.6, -siteD / 2, siteW / 2, -0.05, siteD / 2, Color3.fromRGB(215, 205, 190), Mat.Pavement)
	slab(M, structure, "Floor", -W / 2, -D / 2, W / 2, D / 2, -1, 0, shafts, C.floor, Mat.Marble)
	for _, s in { -1, 1 } do
		box(M, structure, "Inlay", -W / 2 + T, 0, s * (CW / 2 - 4) - 0.5, W / 2 - T, 0.05, s * (CW / 2 - 4) + 0.5, C.inlay, Mat.Marble, DECOR)
		box(M, structure, "Inlay", s * (CW / 2 - 4) - 0.5, 0, -D / 2 + T, s * (CW / 2 - 4) + 0.5, 0.05, -CW / 2 + 4, C.inlay, Mat.Marble, DECOR)
		box(M, structure, "Inlay", s * (CW / 2 - 4) - 0.5, 0, CW / 2 - 4, s * (CW / 2 - 4) + 0.5, 0.05, D / 2 - T, C.inlay, Mat.Marble, DECOR)
	end
	local l2holes = table.clone(shafts)
	for _, v in voids do table.insert(l2holes, v) end
	slab(M, structure, "Level1Floor", -W / 2 + T, -D / 2 + T, W / 2 - T, D / 2 - T, H - ST, H, l2holes, C.gallery, Mat.Marble)
	local sky = hasAtrium and { -VL, -CW / 2, VL, CW / 2 } or nil
	slab(M, structure, "Roof", -W / 2, -D / 2, W / 2, D / 2, 2 * H, 2 * H + ST, sky and { sky } or {}, C.exteriorDark, Mat.Concrete)

	if hasAtrium then
		-- pitched glass skylight with a steel grid, like the reference atrium
		local b, rise = 2 * H + ST, 9
		for _, s in { -1, 1 } do
			ramp(M, structure, "Skylight", Vector3.new(0, b, s * CW / 2), Vector3.new(0, b + rise, 0), 2 * VL, 0.4, C.glass, Mat.Glass, { Transparency = 0.6, Reflectance = 0.3 })
			for x = -VL, VL + 0.1, 12 do
				local rafter = ramp(M, structure, "SkylightBeam", Vector3.new(x, b + 0.05, s * CW / 2), Vector3.new(x, b + rise + 0.05, 0), 0.6, 0.6, C.metal, Mat.Metal)
				rafter.CanCollide = false
			end
		end
		box(M, structure, "SkylightRidge", -VL, b + rise - 0.3, -0.4, VL, b + rise + 0.3, 0.4, C.metal, Mat.Metal)
		for _, x in { -VL, VL } do
			wedge(M, structure, "SkylightGable", Vector3.new(0.4, rise, CW / 2), CFrame.new(x, b + rise / 2, -CW / 4), C.glass, Mat.Glass, GLASS)
			wedge(M, structure, "SkylightGable", Vector3.new(0.4, rise, CW / 2), CFrame.new(x, b + rise / 2, CW / 4) * CFrame.Angles(0, math.pi, 0), C.glass, Mat.Glass, GLASS)
		end

		-- atrium: white bulkheads, balustrades, escalators crossing at the central bridge
		for _, v in voids do
			for _, z in { v[2], v[4] } do
				box(M, structure, "Bulkhead", v[1], H - 4, z - 0.3, v[3], H - ST, z + 0.3, C.ceiling, Mat.SmoothPlastic)
				box(M, structure, "BulkheadLED", v[1], H - 4.3, z - 0.3, v[3], H - 4, z + 0.3, Color3.fromRGB(255, 245, 225), Mat.Neon, DECOR)
				railing(M, structure, v[1], z + (z > 0 and 0.2 or -0.2), v[3], z + (z > 0 and 0.2 or -0.2), H)
			end
			local outer = math.abs(v[1]) > math.abs(v[3]) and v[1] or v[3]
			local inner = outer == v[1] and v[3] or v[1]
			local so = outer > 0 and 1 or -1
			railing(M, structure, outer + so * 0.2, v[2], outer + so * 0.2, v[4], H)
			for _, seg in { { -VW / 2, -10.5 }, { -1.5, 1.5 }, { 10.5, VW / 2 } } do
				railing(M, structure, inner - so * 0.2, seg[1], inner - so * 0.2, seg[2], H)
			end
			buildEscalator(M, moving, Vector3.new(so * (6 + R), 0, 6), Vector3.new(so * 6, H, 6), true)
			buildEscalator(M, moving, Vector3.new(so * (6 + R), 0, -6), Vector3.new(so * 6, H, -6), false)
			planter(M, structure, so * (6 + R + 14), 0, 0, 8, 8, true)
		end
	end

	-- lifts in the north and south arms
	buildElevator(M * CFrame.new(0, 0, zN), moving, "LiftNorth", { 0, H })
	buildElevator(M * CFrame.new(0, 0, -zN) * CFrame.Angles(0, math.pi, 0), moving, "LiftSouth", { 0, H })

	-- concourse lighting under the upper galleries
	for _, s in { -1, 1 } do
		box(M, structure, "ConcourseLight", -W / 2 + T + 2, H - ST - 0.3, s * (CW / 2 - 4) - 0.6, W / 2 - T - 2, H - ST, s * (CW / 2 - 4) + 0.6, Color3.fromRGB(255, 248, 235), Mat.Neon, DECOR)
	end
	for x = -W / 2 + 40, W / 2 - 40, 80 do
		local p = box(M, structure, "ConcourseLamp", x - 1, H - ST - 0.4, -1, x + 1, H - ST - 0.3, 1, Color3.new(1, 1, 1), Mat.Neon, DECOR)
		if p and not (hasAtrium and math.abs(x) < VL) then
			local l = Instance.new("SurfaceLight"); l.Face = Enum.NormalId.Bottom; l.Range = 50; l.Angle = 160; l.Brightness = 1.5; l.Parent = p
		end
		if not (hasAtrium and math.abs(x) < VL + 4) then
			for _, s in { -1, 1 } do
				box(M, structure, "Bench", x - 4, 0, s * 12 - 1, x + 4, 1.8, s * 12 + 1, C.bronze, Mat.Wood)
				planter(M, structure, x + 10, 0, s * 12, 4, 4, false)
			end
		end
	end

	-- outer walls with entrances; east side also opens onto the car park bridge
	local wallTop = 2 * H + 6
	local doorW, doorH = CW / 2 - 4, 16
	local ground = { -doorW, doorW, 0, doorH }
	local bridgeOp = { -8, 8, H, H + 12 }
	local sides = {
		{ name = "West", f = M * CFrame.new(-W / 2, 0, 0) * CFrame.Angles(0, -math.pi / 2, 0), len = D, ops = { ground } },
		{ name = "East", f = M * CFrame.new(W / 2, 0, 0) * CFrame.Angles(0, math.pi / 2, 0), len = D, ops = { ground, bridgeOp } },
		{ name = "North", f = M * CFrame.new(0, 0, D / 2), len = W, ops = { ground } },
		{ name = "South", f = M * CFrame.new(0, 0, -D / 2) * CFrame.Angles(0, math.pi, 0), len = W, ops = { ground } },
	}
	-- in each side frame: +Z points out of the building, X runs along the wall
	for _, sd in sides do
		local f, half = sd.f, sd.len / 2
		wall(f, structure, "OuterWall", -half, half, 0, wallTop, -T / 2, T, sd.ops, C.exterior, Mat.Limestone)
		wall(f, structure, "Band", -half, half, H - 2, H + 1, 0.3, 0.6, sd.ops, C.exteriorDark, Mat.Limestone)
		wall(f, structure, "LEDBand", -half, half, H + 1, H + 1.5, 0.15, 0.3, sd.ops, C.led, Mat.Neon, DECOR)
		wall(f, structure, "Coping", -half, half, wallTop - 1, wallTop, 0.3, 0.6, {}, C.exteriorDark, Mat.Limestone)
		for u = -half + 24, half - 24, 24 do
			if math.abs(u) > doorW + 8 then
				box(f, structure, "Reveal", u - 0.3, 0, 0, u + 0.3, wallTop - 1, 0.25, C.exteriorDark, Mat.Limestone, DECOR)
				if (u // 24) % 2 == 0 then
					box(f, structure, "Window", u + 3, H + 5, 0, u + 21, H + 16, 0.2, C.glass, Mat.Glass, { Reflectance = 0.4 })
				end
			end
		end

		-- bronze-framed glass entrance tower with canopy, sign and planters
		local TW, TD, TH = 2 * doorW + 12, 6, 2 * H + 14
		local tops = { { -doorW, doorW, 0, doorH } }
		if sd.name == "East" then table.insert(tops, bridgeOp) end
		wall(f, structure, "CurtainWall", -TW / 2, TW / 2, 0, TH, TD, 0.4, tops, C.glass, Mat.Glass, { Transparency = 0.25, Reflectance = 0.35 })
		for _, s in { -1, 1 } do box(f, structure, "CurtainWall", s * TW / 2 - 0.2, 0, 0, s * TW / 2 + 0.2, TH, TD, C.glass, Mat.Glass, { Transparency = 0.25, Reflectance = 0.35 }) end
		for u = -TW / 2, TW / 2 + 0.1, 8 do wall(f, structure, "Mullion", u - 0.3, u + 0.3, 0, TH, TD + 0.3, 0.4, tops, C.bronze, Mat.Metal) end
		for y = doorH, TH, 12 do wall(f, structure, "Transom", -TW / 2, TW / 2, y - 0.3, y + 0.3, TD + 0.3, 0.4, tops, C.bronze, Mat.Metal) end
		box(f, structure, "TowerRoof", -TW / 2 - 1, TH, -T, TW / 2 + 1, TH + 1.5, TD + 1, C.bronze, Mat.Metal)
		box(f, structure, "TowerFloor", -TW / 2, -1, 0, TW / 2, 0, TD, C.floor, Mat.Marble)
		local name = box(f, structure, "MallSign", -18, TH - 10, TD + 0.5, 18, TH - 3, TD + 1, C.bronze, Mat.Metal)
		sign(name, Enum.NormalId.Back, Def.name, Color3.fromRGB(255, 250, 235), "GothamBlack")
		box(f, structure, "Canopy", -doorW - 4, doorH + 1, TD, doorW + 4, doorH + 1.6, TD + 14, C.glass, Mat.Glass, { Transparency = 0.4, Reflectance = 0.3 })
		box(f, structure, "CanopyBeam", -doorW - 4, doorH + 0.6, TD + 13.4, doorW + 4, doorH + 1.6, TD + 14, C.bronze, Mat.Metal)
		for _, s in { -1, 1 } do
			post(f, structure, "CanopyColumn", s * (doorW + 3), 0, TD + 13.4, doorH + 1, 1, C.bronze, Mat.Metal)
			planter(f, structure, s * (doorW + 14), 0, TD + 10, 10, 6, true)
			post(f, structure, "LampPost", s * (doorW + 26), 0, TD + 12, 14, 0.5, C.dark, Mat.Metal)
			local lamp = box(f, structure, "LampHead", s * (doorW + 26) - 1, 14, TD + 11, s * (doorW + 26) + 1, 14.6, TD + 13, Color3.fromRGB(255, 240, 200), Mat.Neon, DECOR)
			if lamp then local l = Instance.new("PointLight"); l.Range = 30; l.Brightness = 1; l.Parent = lamp end
		end
	end

	-- rooftop plant
	local rng = Random.new(42)
	for _ = 1, 8 do
		local x = (rng:NextNumber() - 0.5) * (W - 60)
		local z = (rng:NextNumber() > 0.5 and 1 or -1) * (CW / 2 + 20 + rng:NextNumber() * (D / 2 - CW / 2 - 50))
		box(M, structure, "RoofPlant", x - 6, 2 * H + ST, z - 4, x + 6, 2 * H + ST + 5, z + 4, Color3.fromRGB(170, 172, 175), Mat.DiamondPlate)
	end

	-- store units: frontage onto the concourse, full depth back to the outer wall
	local qw = W / 2 - T - CW / 2
	local ud = D / 2 - T - CW / 2
	-- units per quadrant: the target width, but never fewer than needed to fit every store (4 quadrants x 2 levels)
	local n = math.max(1, math.floor(qw / Def.unitWidth + 0.5), math.ceil(#Def.stores / 8))
	local uw = qw / n
	if uw < 50 then warn(string.format("[MallBuilder] stores are only %d studs wide; enlarge MallSite", uw)) end
	local units = {}
	for level = 0, 1 do
		for _, sz in { 1, -1 } do
			for _, sx in { -1, 1 } do
				for i = (sx < 0 and n or 1), (sx < 0 and 1 or n), (sx < 0 and -1 or 1) do
					local x = sx * (CW / 2 + (i - 0.5) * uw)
					local fr = M * CFrame.new(x, level * H, sz * CW / 2) * (sz < 0 and CFrame.Angles(0, math.pi, 0) or CFrame.identity)
					table.insert(units, { fr = fr, ground = level == 0, x = x, sz = sz })
				end
			end
		end
	end
	local placed = {}
	for i, u in units do
		local def = Def.stores[i]
		if def and not Shops[def.shop] then warn("[MallBuilder] unknown shop " .. def.shop); def = nil end
		buildStore(storesFolder, u.fr, uw, ud, hc, def, u.ground)
		if def then
			placed[def.shop] = true
			if u.ground then -- roller door and dock on the outside wall
				local back = M * CFrame.new(u.x, 0, u.sz * D / 2) * (u.sz < 0 and CFrame.Angles(0, math.pi, 0) or CFrame.identity)
				local rx = uw / 2 - 13 -- both frames are mirrored the same way on the south side
				box(back, structure, "RollerDoor", rx - 7, 0, 0, rx + 7, 12, 0.3, Color3.fromRGB(170, 172, 176), Mat.DiamondPlate)
				box(back, structure, "DockLight", rx - 7, 12.5, 0, rx + 7, 13, 0.4, Color3.fromRGB(255, 200, 60), Mat.Neon, DECOR)
				for _, s in { -1, 1 } do box(back, structure, "DockBumper", rx + s * 6 - 0.5, 0, 0, rx + s * 6 + 0.5, 3, 0.8, Color3.fromRGB(240, 200, 0), Mat.Rubber) end
			end
		end
	end
	for _, s in Def.stores do
		if not placed[s.shop] then warn("[MallBuilder] no room for " .. s.shop .. "; enlarge MallSite or lower unitWidth") end
	end
end

--------------------------------------------------------------------------------------------------
-- multi-storey car park: +X faces away from the mall, the bridge lands on the -X side at z = bz

local function buildCarPark(CF, Wc, Dc, root, bridgeDeck, bz)
	local h, N, RW = Def.carParkDeckHeight, Def.carParkLevels, Def.carParkRampWidth
	local Lr = h / math.tan(math.rad(Def.carParkRampDegrees))
	local rx1 = Wc / 2 - 2
	local rx0 = rx1 - RW
	local rz0, rz1 = -Lr / 2, Lr / 2
	local hole = { rx0, rz0, rx1, rz1 }
	local liftX, liftZ = -Wc / 2 + 9, bz + 22
	local liftHole = { liftX - 5, liftZ - 5, liftX + 5, liftZ + 5 }
	local concrete, band, paint = C.deck, C.led, C.lines
	local m = Instance.new("Model"); m.Name = "CarPark"; m.Parent = root

	-- parking rows (x ranges) between drive lanes, bays along z
	local rows = {}
	local x = -Wc / 2 + 2
	table.insert(rows, { x, x + 18, wall = true }); x += 18 + 24
	while x + 36 + 24 <= rx0 do
		table.insert(rows, { x, x + 18 }); table.insert(rows, { x + 18, x + 36, pair = true }); x += 36 + 24
	end
	if x + 18 + 24 <= rx0 then table.insert(rows, { x, x + 18 }) end
	local zA, zB = -Dc / 2 + 28, Dc / 2 - 28

	for lvl = 0, N - 1 do
		local y = lvl * h
		if lvl == 0 then
			slab(CF, m, "Deck", -Wc / 2, -Dc / 2, Wc / 2, Dc / 2, -1, 0, { liftHole }, concrete, Mat.Asphalt)
		else
			slab(CF, m, "Deck", -Wc / 2, -Dc / 2, Wc / 2, Dc / 2, y - 1, y, { hole, liftHole }, concrete, Mat.Concrete)
			box(CF, m, "DeckEdge", -Wc / 2 - 0.3, y - 1.6, -Dc / 2 - 0.3, Wc / 2 + 0.3, y - 1, Dc / 2 + 0.3, C.exteriorDark, Mat.Concrete)
		end
		-- perimeter: parapets on decks (bridge gap on the mall side); low kerbs at ground with open ends
		local ph = lvl == 0 and 1 or 3.5
		local westOps = (lvl == bridgeDeck) and { { bz - 8, bz + 8, y, y + ph + 1 } } or {}
		wallZ(CF, m, "Parapet", -Dc / 2, Dc / 2, y, y + ph, -Wc / 2 + 0.5, 1, westOps, concrete, Mat.Concrete)
		wallZ(CF, m, "Parapet", -Dc / 2, Dc / 2, y, y + ph, Wc / 2 - 0.5, 1, {}, concrete, Mat.Concrete)
		if lvl > 0 then
			for _, s in { -1, 1 } do wall(CF, m, "Parapet", -Wc / 2, Wc / 2, y, y + ph, s * (Dc / 2 - 0.5), 1, {}, concrete, Mat.Concrete) end
			wallZ(CF, m, "ParapetBand", -Dc / 2, Dc / 2, y + 2.6, y + 3.2, -Wc / 2 - 0.1, 0.3, westOps, band, Mat.Neon, DECOR)
			wallZ(CF, m, "ParapetBand", -Dc / 2, Dc / 2, y + 2.6, y + 3.2, Wc / 2 + 0.1, 0.3, {}, band, Mat.Neon, DECOR)
		end
		-- ramp guards: inner rail along the ramp well, barriers where a car could drop or drive under
		box(CF, m, "RampRail", rx0 - 1, y, rz0, rx0, y + 3.5, rz1, Color3.fromRGB(240, 200, 0), Mat.Concrete)
		if lvl == 0 then box(CF, m, "RampBarrier", rx0, y, rz1 - 1, rx1, y + 3.5, rz1, Color3.fromRGB(240, 200, 0), Mat.Concrete) end
		if lvl == N - 1 then box(CF, m, "RampBarrier", rx0, y, rz0, rx1, y + 3.5, rz0 + 1, Color3.fromRGB(240, 200, 0), Mat.Concrete) end
		-- bays, walkway, columns, lights
		for ri, r in rows do
			for z = zA, zB + 0.1, 10 do
				local walkway = ri == 1 and z > bz - 14 and z < bz + 34
				if not walkway then box(CF, m, "BayLine", r[1] + 0.5, y, z - 0.2, r[2] - 0.5, y + 0.05, z + 0.2, paint, Mat.SmoothPlastic, DECOR) end
			end
			if lvl < N - 1 and (r.wall or r.pair) then
				local cx = r.wall and r[1] + 1 or r[1]
				for z = zA, zB + 0.1, 30 do box(CF, m, "Column", cx - 0.9, y, z - 0.9, cx + 0.9, y + h - 1, z + 0.9, concrete, Mat.Concrete) end
			end
		end
		box(CF, m, "Walkway", -Wc / 2 + 2, y, bz - 14, -Wc / 2 + 20, y + 0.05, bz + 34, Color3.fromRGB(60, 140, 90), Mat.SmoothPlastic, DECOR)
		if lvl < N - 1 then
			for z = rz0, rz1 + 0.1, 30 do box(CF, m, "Column", rx0 - 2.8, y, z - 0.9, rx0 - 1, y + h - 1, z + 0.9, concrete, Mat.Concrete) end
			for _, r in rows do
				if not r.pair then
					box(CF, m, "DeckLight", r[2] + 11.5, y + h - 1.3, zA, r[2] + 12.5, y + h - 1, zB, Color3.fromRGB(255, 250, 235), Mat.Neon, DECOR)
				end
			end
		else
			for z = zA, zB, 60 do
				post(CF, m, "LampPost", 0, y, z, 16, 0.5, C.dark, Mat.Metal)
				local lamp = box(CF, m, "LampHead", -1.5, y + 16, z - 1, 1.5, y + 16.6, z + 1, Color3.fromRGB(255, 240, 200), Mat.Neon, DECOR)
				if lamp then local l = Instance.new("PointLight"); l.Range = 40; l.Brightness = 1; l.Parent = lamp end
			end
		end
	end

	-- straight two-way ramps stacked in one well; each climbs one deck along +Z
	for lvl = 0, N - 2 do
		local xm = (rx0 + rx1) / 2
		local p0, p1 = Vector3.new(xm, lvl * h, rz0), Vector3.new(xm, (lvl + 1) * h, rz1)
		ramp(CF, m, "Ramp", p0, p1, RW, 1, concrete, Mat.Concrete)
		for _, s in { -1, 1 } do
			local off = Vector3.new(s * (RW / 2 - 0.5), 0, 0)
			ramp(CF, m, "RampWall", p0 + off + Vector3.new(0, 3.5, 0), p1 + off + Vector3.new(0, 3.5, 0), 1, 3.5, concrete, Mat.Concrete)
		end
		ramp(CF, m, "RampLine", p0 + Vector3.new(0, 0.05, 0), p1 + Vector3.new(0, 0.05, 0), 0.4, 0.05, Color3.fromRGB(240, 200, 0), Mat.SmoothPlastic, DECOR)
	end

	-- entrances, height bars and the big P sign
	for _, s in { -1, 1 } do
		local z = s * (Dc / 2 - 1)
		for _, px in { -Wc / 2 + 1, rx0 - 2 } do post(CF, m, "BarPost", px, 0, z, 11, 0.6, Color3.fromRGB(240, 200, 0), Mat.Metal) end
		local bar = box(CF, m, "HeightBar", -Wc / 2 + 1, 10.4, z - 0.3, rx0 - 2, 11, z + 0.3, Color3.fromRGB(240, 200, 0), Mat.Metal)
		sign(bar, s > 0 and Enum.NormalId.Back or Enum.NormalId.Front, "MAX HEIGHT 10", Color3.new(0, 0, 0), "GothamBold")
	end
	local topY = (N - 1) * h
	local tower = box(CF, m, "SignTower", Wc / 2 - 8, 0, Dc / 2 - 8, Wc / 2, topY + 14, Dc / 2, C.exterior, Mat.Limestone)
	for _, face in { Enum.NormalId.Back, Enum.NormalId.Right } do
		sign(tower, face, "P", Color3.new(1, 1, 1), "GothamBlack", Color3.fromRGB(20, 80, 200))
	end

	buildElevator(CF * CFrame.new(liftX, 0, liftZ) * CFrame.Angles(0, -math.pi / 2, 0), m, "CarParkLift", (function()
		local floors = {}
		for lvl = 0, N - 1 do table.insert(floors, lvl * h) end
		return floors
	end)())
	return m
end

--------------------------------------------------------------------------------------------------

-- Frame on the top of the site Part, turned so local +X faces the car park.
local function mallFrame(site: BasePart, cp: BasePart?)
	local top = site.CFrame * CFrame.new(0, site.Size.Y / 2, 0)
	local W, D, rot = site.Size.X, site.Size.Z, 0
	if cp then
		local rel = top:PointToObjectSpace(cp.Position)
		if math.abs(rel.Z) > math.abs(rel.X) then
			rot = rel.Z > 0 and -math.pi / 2 or math.pi / 2
			W, D = D, W
		elseif rel.X < 0 then
			rot = math.pi
		end
	end
	return top * CFrame.Angles(0, rot, 0), W, D
end

-- Footprint of a Part measured along the axes of frame F.
local function extentsIn(F: CFrame, p: BasePart)
	local rel = F:ToObjectSpace(p.CFrame)
	local s = p.Size
	local function ext(axis)
		return math.abs(rel.XVector[axis]) * s.X + math.abs(rel.YVector[axis]) * s.Y + math.abs(rel.ZVector[axis]) * s.Z
	end
	return rel.Position, ext("X"), ext("Y"), ext("Z")
end

function MallBuilder.Build(rebuild: boolean?)
	local existing = workspace:FindFirstChild("HarbourMall")
	if existing then
		if not rebuild then return existing end
		existing:Destroy()
	end
	local site = workspace:FindFirstChild("MallSite", true)
	if not (site and site:IsA("BasePart")) then warn("[MallBuilder] no Part named MallSite in Workspace"); return nil end
	local cp = workspace:FindFirstChild("CarParkSite", true)
	if cp and not cp:IsA("BasePart") then cp = nil end

	local root = Instance.new("Model")
	root.Name = "HarbourMall"
	local M, W, D = mallFrame(site, cp)
	buildMall(M, W, D, root)

	if cp then
		local pos, ex, ey, ez = extentsIn(M, cp)
		local CF = M * CFrame.new(pos.X, pos.Y + ey / 2, pos.Z)
		local h, H = Def.carParkDeckHeight, Def.floorHeight
		local deck = math.clamp(math.floor((H - (pos.Y + ey / 2)) / h + 0.5), 1, Def.carParkLevels - 1)
		local bz = math.clamp(-pos.Z, -ez / 2 + 40, ez / 2 - 50) -- bridge stays on the mall's centre line
		buildCarPark(CF, ex, ez, root, deck, bz)
		-- footbridge from the mall's upper level to the car park deck
		local a = Vector3.new(W / 2 - SETBACK - 2, H, 0)
		local bWorld = (CF * CFrame.new(-ex / 2 + 0.5, deck * h, bz)).Position
		local b = M:PointToObjectSpace(bWorld)
		b = Vector3.new(b.X, b.Y, 0)
		local bridge = Instance.new("Model"); bridge.Name = "Footbridge"; bridge.Parent = root
		local _, across = ramp(M, bridge, "BridgeDeck", a, b, 16, 1.5, C.gallery, Mat.Marble)
		for _, s in { -1, 1 } do
			local off = across * s * 7.85
			ramp(M, bridge, "BridgeRail", a + off + Vector3.new(0, 4, 0), b + off + Vector3.new(0, 4, 0), 0.3, 4, C.glass, Mat.Glass, CLEAR)
			ramp(M, bridge, "BridgeHandrail", a + off + Vector3.new(0, 4.35, 0), b + off + Vector3.new(0, 4.35, 0), 0.5, 0.35, C.metal, Mat.Metal)
		end
		ramp(M, bridge, "BridgeFascia", a - Vector3.new(0, 1.5, 0), b - Vector3.new(0, 1.5, 0), 16.4, 1.5, C.exteriorDark, Mat.Limestone)
		cp.Transparency = 1; cp.CanCollide = false; cp.CanQuery = false
	end
	site.Transparency = 1; site.CanCollide = false; site.CanQuery = false
	root.Parent = workspace
	return root
end

return MallBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX24"><Properties><string name="Name">MallService</string><ProtectedString name="Source"><![CDATA[-- Harbour Mall at runtime: builds the mall if the place has a MallSite but no baked "HarbourMall",
-- then runs every escalator (conveyor steps) and lift (server-owned prismatic car with floor gates).
-- Works the same for a mall built at runtime or baked into the place with MallBuilder in Studio.
local CollectionService = game:GetService("CollectionService")
local MallBuilder = require(script.Parent.MallBuilder)

local MallService = {}

local function runEscalator(steps: Instance)
	local v = steps:GetAttribute("Conveyor")
	if steps:IsA("BasePart") and typeof(v) == "Vector3" then steps.AssemblyLinearVelocity = v end
end

local function runLift(m: Instance)
	local car = m:FindFirstChild("Car")
	local lift = m:FindFirstChild("Lift")
	if not (car and car:IsA("BasePart") and lift and lift:IsA("PrismaticConstraint")) then return end
	pcall(function() car:SetNetworkOwner(nil) end) -- server moves the car so riders can't desync it
	local stops = {}
	for s in string.gmatch(m:GetAttribute("Stops") or "", "[^,]+") do table.insert(stops, tonumber(s)) end
	local queue = {}
	local function request(i: number)
		if not table.find(queue, i) then table.insert(queue, i) end
	end
	for i in stops do
		for _, name in { "Call_" .. i, "Floor_" .. i } do
			local button = m:FindFirstChild(name)
			local cd = button and button:FindFirstChildOfClass("ClickDetector")
			if cd then cd.MouseClick:Connect(function() request(i) end) end
		end
	end
	-- travel loop: one stop at a time, doors stay open for a moment at each
	task.spawn(function()
		while m.Parent do
			local i = table.remove(queue, 1)
			if i then
				lift.TargetPosition = stops[i]
				local started = os.clock()
				while math.abs(lift.CurrentPosition - stops[i]) > 0.1 and os.clock() - started < 30 do task.wait(0.1) end
				task.wait(3)
			else
				task.wait(0.2)
			end
		end
	end)
	-- a floor's gate opens only while the car is stopped at that floor
	task.spawn(function()
		while m.Parent do
			for i, offset in stops do
				local gate = m:FindFirstChild("Gate_" .. i)
				if gate and gate:IsA("BasePart") then
					local open = math.abs(lift.CurrentPosition - offset) < 0.3 and math.abs(lift.TargetPosition - offset) < 0.01
					gate.CanCollide = not open
					gate.Transparency = open and 1 or 0.55
				end
			end
			task.wait(0.1)
		end
	end)
end

function MallService.Start()
	if not workspace:FindFirstChild("HarbourMall") and workspace:FindFirstChild("MallSite", true) then
		local started = os.clock()
		MallBuilder.Build()
		print(string.format("[Harbourlife] mall built in %.2fs", os.clock() - started))
	end
	for _, p in CollectionService:GetTagged("HarbourEscalator") do runEscalator(p) end
	CollectionService:GetInstanceAddedSignal("HarbourEscalator"):Connect(runEscalator)
	for _, m in CollectionService:GetTagged("HarbourElevator") do runLift(m) end
	CollectionService:GetInstanceAddedSignal("HarbourElevator"):Connect(runLift)
end

return MallService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX25"><Properties><string name="Name">NotificationService</string><ProtectedString name="Source"><![CDATA[local Remotes = require(game.ReplicatedStorage.Shared.Remotes)
local N = {}
function N.Send(player: Player, text: string, kind: string?)
	Remotes.Notify:FireClient(player, tostring(text):sub(1, 120), kind or "info")
end
return N
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX26"><Properties><string name="Name">PizzaService</string><ProtectedString name="Source"><![CDATA[-- Pizza Business: supplier -> oven -> orders (counter / delivery) -> payment, XP, reputation.
-- Workspace markers (rename Parts, no scripts needed):
--   PizzaSupplier        buys ingredients
--   PizzaOven_<n>        cooks pizza
--   PizzaCounter         serves counter orders
--   PizzaDropoff_<n>     delivery destinations
local Players = game:GetService("Players")
local Items = require(game.ReplicatedStorage.Shared.ItemDefinitions)
local Recipes = require(game.ReplicatedStorage.Shared.RecipeDefinitions)
local Biz = require(game.ReplicatedStorage.Shared.BusinessDefinitions).pizza_shop
local DataService = require(script.Parent.DataService)
local Economy = require(script.Parent.EconomyService)
local Inventory = require(script.Parent.InventoryService)
local Progression = require(script.Parent.ProgressionService)
local JobService = require(script.Parent.JobService)
local Interaction = require(script.Parent.InteractionService)
local Notify = require(script.Parent.NotificationService)

local P = {}
local recipe = Recipes.pizza
local ovens: { [Instance]: { owner: Player?, doneAt: number?, ready: boolean } } = {}
local orders: { { id: number, kind: string, dropoff: string?, expires: number } } = {}
local nextId = 1
local dropoffNames: { string } = {}

local function takesPizzaJobs(player) -- anyone with the cook or driver job counts as staff
	local d = DataService.Get(player)
	return d and (d.job == "pizza_cook" or d.job == "delivery_driver")
end

local function staffOnline()
	for _, p in Players:GetPlayers() do if takesPizzaJobs(p) then return true end end
	return false
end

local function reputationChange(player, delta)
	local d = DataService.Get(player)
	if d then d.reputation += delta; DataService.Push(player) end
end

local function removeOrder(i) table.remove(orders, i) end

local function expireOrders()
	for i = #orders, 1, -1 do
		if os.clock() >= orders[i].expires then
			removeOrder(i)
			for _, p in Players:GetPlayers() do
				if takesPizzaJobs(p) then reputationChange(p, Biz.reputationOnExpire); Notify.Send(p, "An order expired", "error") end
			end
		end
	end
end

local function spawnOrder()
	if #orders >= Biz.maxOpenOrders then return end
	local isDelivery = #dropoffNames > 0 and math.random() < 0.5
	local o = {
		id = nextId, kind = isDelivery and "delivery" or "counter",
		dropoff = isDelivery and dropoffNames[math.random(#dropoffNames)] or nil,
		expires = os.clock() + Biz.orderLifetimeSeconds,
	}
	nextId += 1
	table.insert(orders, o)
	for _, p in Players:GetPlayers() do
		if takesPizzaJobs(p) then
			Notify.Send(p, o.kind == "delivery" and ("New delivery order: " .. o.dropoff) or "New counter order", "info")
		end
	end
end

local function findOrder(kind, dropoff)
	for i, o in orders do
		if o.kind == kind and (kind == "counter" or o.dropoff == dropoff) then return i, o end
	end
end

-- Supplier: buys one full set of ingredients for the pizza recipe, atomically.
local function buyIngredients(player)
	if not DataService.Get(player) then return end
	local cost = 0
	for id, n in recipe.inputs do cost += Items[id].price * n end
	if not Economy.SpendCash(player, cost) then Notify.Send(player, "Need $" .. cost, "error"); return end
	local added = {}
	for id, n in recipe.inputs do
		if Inventory.Add(player, id, n) then added[id] = n
		else
			for rid, rn in added do Inventory.Remove(player, rid, rn) end
			Economy.AddCash(player, cost)
			Notify.Send(player, "Inventory full", "error")
			return
		end
	end
	Notify.Send(player, "Bought ingredients for $" .. cost, "success")
end

local function ovenInteract(player, oven)
	local st = ovens[oven]
	local d = DataService.Get(player)
	if not d then return end
	-- stale owner left the game
	if st.owner and not st.owner.Parent then st.owner, st.doneAt, st.ready = nil, nil, false end
	if st.ready and st.owner == player then
		if not Inventory.Add(player, recipe.output, 1) then Notify.Send(player, "Inventory full", "error"); return end
		st.owner, st.doneAt, st.ready = nil, nil, false
		JobService.CompleteTask(player, "pizza_cook")
		Notify.Send(player, "Pizza ready", "success")
	elseif st.owner then
		if st.owner == player and st.doneAt then Notify.Send(player, "Still cooking...", "info")
		else Notify.Send(player, "Oven in use", "error") end
	else
		for id, n in recipe.inputs do
			if Inventory.Count(player, id) < n then Notify.Send(player, "Missing " .. Items[id].name, "error"); return end
		end
		for id, n in recipe.inputs do Inventory.Remove(player, id, n) end
		local secs = math.max(Biz.minCookSeconds, recipe.cookSeconds - Progression.SkillLevel(player, "cooking"))
		st.owner, st.doneAt, st.ready = player, os.clock() + secs, false
		task.delay(secs, function()
			if st.owner == player and st.doneAt then st.ready = true; st.doneAt = nil; Notify.Send(player, "Your pizza is ready!", "success") end
		end)
		Notify.Send(player, "Cooking for " .. secs .. "s", "info")
	end
end

local function serve(player, kind, dropoff)
	local i, o = findOrder(kind, dropoff)
	if not i then Notify.Send(player, "No matching order", "error"); return end
	if not Inventory.Remove(player, "pizza", 1) then Notify.Send(player, "You need a pizza", "error"); return end
	removeOrder(i)
	local mult = kind == "delivery" and Biz.deliveryMultiplier or Biz.counterMultiplier
	local price = math.floor(Items.pizza.price * mult)
	Economy.AddCash(player, price)
	local job = kind == "delivery" and "delivery_driver" or "pizza_cook"
	JobService.CompleteTask(player, job) -- extra job pay + XP only if the player holds that job
	Progression.AddXp(player, 5)
	reputationChange(player, Biz.reputationOnServe)
	Notify.Send(player, "Order complete: +$" .. price, "success")
end

local function hook(inst: Instance)
	if not inst:IsA("BasePart") then return end
	if inst.Name == "PizzaSupplier" then
		Interaction.Register(inst, { action = "Buy ingredients", object = "Supplier", onTriggered = buyIngredients })
	elseif inst.Name:match("^PizzaOven_") then
		ovens[inst] = { ready = false }
		Interaction.Register(inst, { action = "Use oven", object = "Pizza Oven", onTriggered = function(p) ovenInteract(p, inst) end })
	elseif inst.Name == "PizzaCounter" then
		Interaction.Register(inst, { action = "Serve order", object = "Counter", onTriggered = function(p) serve(p, "counter") end })
	elseif inst.Name:match("^PizzaDropoff_") then
		table.insert(dropoffNames, inst.Name)
		Interaction.Register(inst, { action = "Deliver pizza", object = inst.Name, onTriggered = function(p) serve(p, "delivery", inst.Name) end })
	end
end

function P.Start()
	for _, d in workspace:GetDescendants() do hook(d) end
	workspace.DescendantAdded:Connect(hook)
	task.spawn(function()
		while true do
			task.wait(Biz.orderIntervalSeconds)
			expireOrders()
			if staffOnline() then spawnOrder() end
		end
	end)
end

-- test hook
function P._orders() return orders end

return P
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX27"><Properties><string name="Name">ProgressionService</string><ProtectedString name="Source"><![CDATA[local Config = require(game.ReplicatedStorage.Shared.Config)
local Skills = require(game.ReplicatedStorage.Shared.SkillDefinitions)
local DataService = require(script.Parent.DataService)
local Notify = require(script.Parent.NotificationService)

local P = {}

function P.XpForNext(level: number): number
	return math.floor(Config.XpBase * level ^ Config.XpExponent)
end

function P.AddXp(player: Player, amount: number): boolean
	local d = DataService.Get(player)
	if not d or type(amount) ~= "number" or amount ~= amount or amount <= 0 or amount > 1e6 then return false end
	d.xp += math.floor(amount)
	while d.level < Config.MaxLevel and d.xp >= P.XpForNext(d.level) do
		d.xp -= P.XpForNext(d.level)
		d.level += 1
		Notify.Send(player, "Level up! You are now level " .. d.level, "success")
	end
	if d.level >= Config.MaxLevel then d.xp = 0 end
	DataService.Push(player)
	return true
end

-- skills[id] = { level, xp }
function P.AddSkillXp(player: Player, skillId: string, amount: number): boolean
	local d = DataService.Get(player)
	if not d or not Skills[skillId] or type(amount) ~= "number" or amount <= 0 or amount > 1e6 then return false end
	local s = d.skills[skillId] or { level = 1, xp = 0 }
	d.skills[skillId] = s
	if s.level >= Config.MaxSkillLevel then return true end
	s.xp += math.floor(amount)
	while s.level < Config.MaxSkillLevel and s.xp >= Config.SkillXpBase * s.level do
		s.xp -= Config.SkillXpBase * s.level
		s.level += 1
		Notify.Send(player, Skills[skillId].name .. " is now level " .. s.level, "success")
	end
	DataService.Push(player)
	return true
end

function P.SkillLevel(player: Player, skillId: string): number
	local d = DataService.Get(player)
	return d and d.skills[skillId] and d.skills[skillId].level or 1
end

return P
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX28"><Properties><string name="Name">ShopService</string><ProtectedString name="Source"><![CDATA[-- Retail: browse a shop at its counter, buy with server-validated price, range and stock.
local Players = game:GetService("Players")
local Config = require(game.ReplicatedStorage.Shared.Config)
local Items = require(game.ReplicatedStorage.Shared.ItemDefinitions)
local Shops = require(game.ReplicatedStorage.Shared.ShopDefinitions)
local Remotes = require(game.ReplicatedStorage.Shared.Remotes)
local DataService = require(script.Parent.DataService)
local Economy = require(script.Parent.EconomyService)
local Inventory = require(script.Parent.InventoryService)
local Interaction = require(script.Parent.InteractionService)
local Notify = require(script.Parent.NotificationService)

local ShopService = {}
local counters: { [string]: { BasePart } } = {}
local stock: { [string]: { [string]: number } } = {}
local lastBuy: { [Player]: number } = {}

function ShopService.Price(shopId: string, itemId: string): number
	return math.ceil(Items[itemId].price * Shops[shopId].markup)
end

local function nearShop(player: Player, shopId: string): boolean
	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then return false end
	for _, p in counters[shopId] or {} do
		if p.Parent and (p.Position - hrp.Position).Magnitude <= Config.ShopRange then return true end
	end
	return false
end

local function payload(shopId: string)
	local def = Shops[shopId]
	local list = {}
	for _, id in def.items do
		table.insert(list, { id = id, name = Items[id].name, price = ShopService.Price(shopId, id), stock = stock[shopId][id] })
	end
	return { id = shopId, name = def.name, items = list }
end

local function open(player: Player, shopId: string)
	Remotes.OpenShop:FireClient(player, payload(shopId))
end

local function buy(player: Player, shopId: any, itemId: any, qty: any)
	-- validate everything the client sent
	if type(shopId) ~= "string" or type(itemId) ~= "string" or type(qty) ~= "number" then return end
	local def = Shops[shopId]
	if not def or not Items[itemId] or not table.find(def.items, itemId) then return end
	if qty ~= qty or qty % 1 ~= 0 or qty < 1 or qty > Config.ShopMaxQty then return end
	local now = os.clock()
	if now - (lastBuy[player] or 0) < 0.2 then return end
	lastBuy[player] = now
	if not DataService.Get(player) then return end
	if not nearShop(player, shopId) then Notify.Send(player, "Walk back to the counter", "error"); return end

	if stock[shopId][itemId] < qty then Notify.Send(player, "Out of stock", "error"); open(player, shopId); return end
	local total = ShopService.Price(shopId, itemId) * qty
	if not Economy.SpendCash(player, total) then Notify.Send(player, "Need $" .. total, "error"); return end
	if not Inventory.Add(player, itemId, qty) then
		Economy.AddCash(player, total) -- refund
		Notify.Send(player, "No room in your inventory", "error")
		return
	end
	stock[shopId][itemId] -= qty
	Notify.Send(player, string.format("Bought %dx %s for $%d", qty, Items[itemId].name, total), "success")
	open(player, shopId) -- refresh stock on the client
end

local function hook(inst: Instance)
	if not inst:IsA("BasePart") then return end
	local shopId = inst.Name:match("^Shop_(.+)$")
	if not shopId or not Shops[shopId] then return end
	counters[shopId] = counters[shopId] or {}
	table.insert(counters[shopId], inst)
	Interaction.Register(inst, { action = "Browse", object = Shops[shopId].name, onTriggered = function(p) open(p, shopId) end })
end

function ShopService.Start()
	for id, def in Shops do
		stock[id] = {}
		for _, itemId in def.items do
			assert(Items[itemId], "ShopDefinitions: unknown item " .. itemId .. " in " .. id)
			stock[id][itemId] = def.stock
		end
	end
	for _, d in workspace:GetDescendants() do hook(d) end
	workspace.DescendantAdded:Connect(hook)
	Remotes.ShopBuy.OnServerEvent:Connect(buy)
	Players.PlayerRemoving:Connect(function(p) lastBuy[p] = nil end)
	-- one restock loop for all shops
	task.spawn(function()
		local elapsed = 0
		while true do
			task.wait(5)
			elapsed += 5
			for id, def in Shops do
				if elapsed % def.restockSeconds < 5 then
					for itemId, n in stock[id] do stock[id][itemId] = math.min(def.stock, n + 1) end
				end
			end
		end
	end)
end

return ShopService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX29"><Properties><string name="Name">TestWorld</string><ProtectedString name="Source"><![CDATA[-- Dev-only placeholder test area. Builds labelled, correctly named Parts near the origin
-- so every Phase 1/2 system can be exercised. Delete or set Enabled=false once the real map exists.
local TestWorld = { Enabled = true }

local function pad(name: string, pos: Vector3, color: Color3, size: Vector3?)
	if workspace:FindFirstChild(name, true) then return end -- never duplicate or overwrite map objects
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size or Vector3.new(6, 4, 6)
	p.Position = pos
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.Parent = workspace
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(200, 40)
	gui.StudsOffset = Vector3.new(0, 4, 0)
	gui.AlwaysOnTop = true
	gui.Parent = p
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0
	label.Text = name
	label.Parent = gui
end

function TestWorld.Start()
	if not TestWorld.Enabled then return end
	game.Players.PlayerAdded:Connect(function(p) task.spawn(TestWorld.GrantExcavator, p) end)
	for _, p in game.Players:GetPlayers() do task.spawn(TestWorld.GrantExcavator, p) end
	if not workspace:FindFirstChild("TestFloor") then
		local f = Instance.new("Part")
		f.Name = "TestFloor"; f.Anchored = true
		f.Size = Vector3.new(120, 1, 120); f.Position = Vector3.new(0, -0.5, 0)
		f.Color = Color3.fromRGB(90, 140, 90); f.Parent = workspace
	end
	if not workspace:FindFirstChild("DigZoneSign") then
		workspace.Terrain:FillBlock(CFrame.new(80, 0, -30), Vector3.new(40, 16, 40), Enum.Material.Ground)
		pad("DigZoneSign", Vector3.new(58, 2, -30), Color3.fromRGB(240, 190, 30), Vector3.new(2, 4, 8))
	end
	pad("JobCentre_pizza_cook", Vector3.new(-30, 2, 0), Color3.fromRGB(60, 120, 220))
	pad("JobCentre_delivery_driver", Vector3.new(-30, 2, 12), Color3.fromRGB(60, 120, 220))
	pad("PizzaSupplier", Vector3.new(-10, 2, -20), Color3.fromRGB(150, 100, 50))
	pad("PizzaOven_1", Vector3.new(0, 2, -20), Color3.fromRGB(200, 60, 40))
	pad("PizzaOven_2", Vector3.new(10, 2, -20), Color3.fromRGB(200, 60, 40))
	pad("PizzaCounter", Vector3.new(20, 2, -10), Color3.fromRGB(230, 200, 60))
	pad("PizzaDropoff_1", Vector3.new(30, 2, 20), Color3.fromRGB(90, 200, 120))
	pad("PizzaDropoff_2", Vector3.new(10, 2, 35), Color3.fromRGB(90, 200, 120))
	-- vehicles (Phase 3)
	pad("VehicleSpawn", Vector3.new(-40, 0.6, -40), Color3.fromRGB(70, 70, 70), Vector3.new(24, 1, 24))
	for i, id in { "sedan", "pickup", "delivery_van", "excavator" } do
		pad("VehicleGarage_" .. id, Vector3.new(-50 + i * 8, 2, -62), Color3.fromRGB(120, 120, 200), Vector3.new(6, 4, 6))
		if id ~= "sedan" then pad("VehicleShop_" .. id, Vector3.new(-50 + i * 8, 2, -72), Color3.fromRGB(200, 160, 60), Vector3.new(6, 4, 6)) end
	end
	-- Harbour Mall test site (retail shops live inside the mall). Your real map supplies its own
	-- MallSite / CarParkSite Parts; these are only made when the map has none.
	if not workspace:FindFirstChild("MallSite", true) then
		local function ground(name, size, pos, color)
			local g = Instance.new("Part")
			g.Name = name; g.Anchored = true; g.Size = size; g.Position = pos; g.Color = color
			g.Material = Enum.Material.Asphalt; g.Parent = workspace
			return g
		end
		ground("MallTestGround", Vector3.new(800, 1, 600), Vector3.new(100, -0.5, 360), Color3.fromRGB(70, 72, 76))
		ground("MallSite", Vector3.new(480, 1, 480), Vector3.new(-40, -0.4, 360), Color3.fromRGB(200, 190, 170))
		ground("CarParkSite", Vector3.new(220, 1, 480), Vector3.new(350, -0.4, 360), Color3.fromRGB(90, 90, 95))
	end
	-- food businesses (Phase 5): one row per business, counter then stations
	for i, job in { "barista", "baker", "chef", "waiter", "fast_food_worker" } do
		pad("JobCentre_" .. job, Vector3.new(-42, 2, -12 + i * 8), Color3.fromRGB(60, 120, 220))
	end
	pad("Shop_food_wholesale", Vector3.new(18, 2, -36), Color3.fromRGB(150, 90, 200))
	local food = {
		{ "CafeCounter", "CafeCoffeeMachine_1", "CafeToaster_1" },
		{ "BakeryCounter", "BakeryOven_1", "BakeryOven_2" },
		{ "RestaurantCounter", "RestaurantStove_1", "RestaurantStove_2" },
		{ "FastFoodCounter", "FastFoodGrill_1", "FastFoodFryer_1" },
	}
	for row, names in food do
		for col, name in names do
			local color = col == 1 and Color3.fromRGB(230, 200, 60) or Color3.fromRGB(200, 60, 40)
			pad(name, Vector3.new(20 + col * 8, 2, -8 - row * 12), color)
		end
	end
	pad("FuelStation", Vector3.new(-20, 2, -40), Color3.fromRGB(230, 90, 60), Vector3.new(4, 4, 4))
	pad("Garage_Repair", Vector3.new(-20, 2, -50), Color3.fromRGB(60, 180, 180), Vector3.new(6, 4, 6))
end

-- Dev only: every player gets the excavator for free so it can be perfected.
function TestWorld.GrantExcavator(player: Player)
	local DataService = require(script.Parent.DataService)
	for _ = 1, 60 do
		local d = DataService.Get(player)
		if d then
			d.vehicles.excavator = d.vehicles.excavator or { fuel = 120, condition = 100 }
			DataService.Push(player)
			return
		end
		task.wait(0.5)
	end
end

return TestWorld
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX30"><Properties><string name="Name">VehicleService</string><ProtectedString name="Source"><![CDATA[-- Vehicle ownership, spawning, fuel, wear and repair. Server-authoritative.
-- Driving physics run on the driver's client (VehicleDriver.client.luau) via constraints built here.
-- Workspace markers:
--   VehicleGarage_<id>   toggle: store current vehicle / take out <id>
--   VehicleShop_<id>     buy vehicle <id>
--   FuelStation          refuel active vehicle (must be nearby)
--   Garage_Repair        repair active vehicle (must be nearby)
--   VehicleSpawn         where vehicles appear (falls back to in front of the player)
local Players = game:GetService("Players")
local Config = require(game.ReplicatedStorage.Shared.Config)
local Defs = require(game.ReplicatedStorage.Shared.VehicleDefinitions)
local DataService = require(script.Parent.DataService)
local Economy = require(script.Parent.EconomyService)
local Interaction = require(script.Parent.InteractionService)
local Notify = require(script.Parent.NotificationService)

local V = {}
local active: { [Player]: { id: string, model: Model, body: BasePart, seat: VehicleSeat, fuel: number, condition: number } } = {}

local function part(parent, name, size, cf, color, collide)
	local p = Instance.new("Part")
	p.Name = name; p.Size = size; p.CFrame = cf; p.Color = color
	p.CanCollide = collide ~= false; p.Massless = collide == false
	p.TopSurface = Enum.SurfaceType.Smooth; p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function weld(a, b)
	local w = Instance.new("WeldConstraint"); w.Part0 = a; w.Part1 = b; w.Parent = a
end

-- Articulated excavator: Body -(swing)- Cab -(boom)- Boom -(stick)- Stick -(bucket)- Bucket.
-- Every hinge is a servo; at TargetAngle 0 the arm is in its rest pose. The driver's client sets targets.
local function hinge(name, a, b, frameCF, limits, speed)
	local h = Instance.new("HingeConstraint")
	h.Name = name
	local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
	a0.CFrame = a.CFrame:ToObjectSpace(frameCF); a0.Parent = a
	a1.CFrame = b.CFrame:ToObjectSpace(frameCF); a1.Parent = b
	h.Attachment0 = a0; h.Attachment1 = a1
	h.ActuatorType = Enum.ActuatorType.Servo
	h.AngularSpeed = speed; h.ServoMaxTorque = 5e6; h.TargetAngle = 0
	if limits then h.LimitsEnabled = true; h.LowerAngle = limits[1]; h.UpperAngle = limits[2] end
	h.Parent = a
	return h
end

local function deco(parent: BasePart, model, name, size, localCF, color, material, shape)
	local p = part(model, name, size, parent.CFrame * localCF, color, false)
	if material then p.Material = material end
	if shape then p.Shape = shape end
	weld(parent, p)
	return p
end

-- Coordinates below are relative to the vehicle's own frame (cf): -Z is forward, +Y is up.
local function buildExcavator(model, body, cf, s, def)
	local yellow, dark, steel = def.color, Color3.fromRGB(35, 35, 38), Color3.fromRGB(120, 120, 125)
	local Metal, Glass = Enum.Material.Metal, Enum.Material.Glass
	local top = s.Y / 2

	-- Undercarriage: body is the invisible collider; tracks, frame and sprockets are visual.
	body.Transparency = 1
	deco(body, model, "Frame", Vector3.new(5, 1.6, 8), CFrame.new(0, 0.3, 0), dark, Metal)
	for _, x in { -3.8, 3.8 } do
		deco(body, model, "Track", Vector3.new(2.4, 2.6, 12.4), CFrame.new(x, -0.2, 0), Color3.fromRGB(25, 25, 25), Enum.Material.Slate)
		for _, z in { -5.4, 5.4 } do
			deco(body, model, "Sprocket", Vector3.new(2.6, 2.8, 2.8), CFrame.new(x, -0.2, z), steel, Metal, Enum.PartType.Cylinder)
		end
		for i = -5, 5 do
			deco(body, model, "TrackPad", Vector3.new(2.5, 0.25, 0.45), CFrame.new(x, 1.15, i * 1.1), Color3.fromRGB(45, 45, 45), Metal)
		end
	end

	-- Upper structure on a turntable ("Cab") that swings on the undercarriage.
	local cab = part(model, "Cab", Vector3.new(8, 1, 10), cf * CFrame.new(0, top + 0.5, 0), dark, false)
	cab.Material = Metal
	-- pos is in vehicle space; convert to turntable space (turntable sits at y = top + 0.5)
	local function onCab(name, size, pos, color, material, rot)
		return deco(cab, model, name, size, CFrame.new(pos - Vector3.new(0, top + 0.5, 0)) * (rot or CFrame.identity), color, material)
	end
	-- operator cab (front left): solid lower walls, glass upper, roof
	onCab("CabBack", Vector3.new(3.6, 4.6, 0.2), Vector3.new(-2.2, 4.8, -0.5), yellow, Metal)
	onCab("CabSideLow", Vector3.new(0.2, 1.6, 4.4), Vector3.new(-3.9, 3.3, -2.6), yellow, Metal)
	onCab("CabSideGlass", Vector3.new(0.2, 3.0, 4.4), Vector3.new(-3.9, 5.6, -2.6), Color3.fromRGB(160, 200, 220), Glass).Transparency = 0.6
	onCab("CabInnerGlass", Vector3.new(0.2, 4.6, 4.4), Vector3.new(-0.5, 4.8, -2.6), Color3.fromRGB(160, 200, 220), Glass).Transparency = 0.6
	onCab("CabFrontGlass", Vector3.new(3.6, 4.6, 0.2), Vector3.new(-2.2, 4.8, -4.7), Color3.fromRGB(160, 200, 220), Glass).Transparency = 0.6
	onCab("CabRoof", Vector3.new(3.9, 0.3, 4.7), Vector3.new(-2.2, 7.25, -2.6), yellow, Metal)
	for i, x in { -3.3, -1.1 } do
		local lamp = onCab("WorkLight" .. i, Vector3.new(0.7, 0.4, 0.3), Vector3.new(x, 7.6, -4.6), Color3.fromRGB(255, 245, 210), Enum.Material.Neon)
		local light = Instance.new("SpotLight"); light.Face = Enum.NormalId.Front; light.Range = 40; light.Brightness = 2; light.Parent = lamp
	end
	-- engine housing, counterweight, exhaust
	onCab("EngineHousing", Vector3.new(8, 2.8, 3.6), Vector3.new(0, 3.9, 3.0), yellow, Metal)
	local cw = onCab("Counterweight", Vector3.new(8, 2.2, 1.2), Vector3.new(0, 3.4, 5.3), dark, Metal)
	local sg = Instance.new("SurfaceGui"); sg.Face = Enum.NormalId.Back; sg.Parent = cw
	local txt = Instance.new("TextLabel"); txt.Size = UDim2.fromScale(1, 1); txt.BackgroundTransparency = 1
	txt.Text = "HARBOURLIFE"; txt.TextScaled = true; txt.Font = Enum.Font.GothamBlack; txt.TextColor3 = yellow; txt.Parent = sg
	onCab("Exhaust", Vector3.new(1.6, 0.4, 0.4), Vector3.new(2.6, 6.0, 2.4), dark, Metal, CFrame.Angles(0, 0, math.rad(90))).Shape = Enum.PartType.Cylinder
	onCab("BoomMount", Vector3.new(1.8, 1.6, 2), Vector3.new(1.2, 3.3, -3.5), dark, Metal)

	-- Boom, stick and bucket (each on its own servo hinge)
	local P1 = CFrame.new(1.2, top + 2.2, -3.5)
	local boomFrame = P1 * CFrame.Angles(math.rad(35), 0, 0)
	local boom = part(model, "Boom", Vector3.new(1.4, 1.8, 11), cf * boomFrame * CFrame.new(0, 0, -5.5), yellow, false)
	boom.Material = Metal
	deco(boom, model, "BoomRam", Vector3.new(8, 0.5, 0.5), CFrame.new(0, 1.15, 0.5) * CFrame.Angles(0, math.rad(90), 0), steel, Metal, Enum.PartType.Cylinder)
	local E1 = boomFrame * CFrame.new(0, 0, -11)
	local stickFrame = CFrame.new(E1.Position) * CFrame.Angles(math.rad(-50), 0, 0)
	local stick = part(model, "Stick", Vector3.new(1.1, 1.4, 7), cf * stickFrame * CFrame.new(0, 0, -3.5), yellow, false)
	stick.Material = Metal
	deco(stick, model, "StickRam", Vector3.new(5, 0.4, 0.4), CFrame.new(0, 0.95, 0.4) * CFrame.Angles(0, math.rad(90), 0), steel, Metal, Enum.PartType.Cylinder)
	local E2 = stickFrame * CFrame.new(0, 0, -7)
	local bucketFrame = CFrame.new(E2.Position) * CFrame.Angles(math.rad(-85), 0, 0)
	local bucket = part(model, "Bucket", Vector3.new(4, 2, 3), cf * bucketFrame * CFrame.new(0, 0, -1.5), dark, false)
	bucket.Material = Metal
	for _, x in { -2.1, 2.1 } do
		deco(bucket, model, "BucketSide", Vector3.new(0.25, 2.6, 3.2), CFrame.new(x, -0.3, 0), dark, Metal)
	end
	for _, x in { -1.5, -0.5, 0.5, 1.5 } do
		deco(bucket, model, "Tooth", Vector3.new(0.45, 0.35, 0.8), CFrame.new(x, -0.5, -1.8), steel, Metal)
	end
	-- dirt heap shown while the bucket is loaded (server toggles transparency)
	local dirt = deco(bucket, model, "BucketDirt", Vector3.new(3.6, 0.8, 2.6), CFrame.new(0, -1.3, 0.2), Color3.fromRGB(110, 80, 50), Enum.Material.Ground)
	dirt.Transparency = 1
	local tip = Instance.new("Attachment"); tip.Name = "Tip"; tip.CFrame = CFrame.new(0, 0, -1.8); tip.Parent = bucket
	local dust = Instance.new("ParticleEmitter")
	dust.Name = "Dust"; dust.Enabled = false; dust.Rate = 80
	dust.Color = ColorSequence.new(Color3.fromRGB(120, 90, 60)); dust.Size = NumberSequence.new(0.7, 0.2)
	dust.Lifetime = NumberRange.new(0.5, 0.9); dust.Speed = NumberRange.new(6, 10); dust.SpreadAngle = Vector2.new(60, 60)
	dust.Acceleration = Vector3.new(0, -30, 0); dust.Parent = tip

	hinge("SwingHinge", body, cab, cf * CFrame.new(0, top, 0) * CFrame.Angles(0, 0, math.rad(90)), nil, 1.0)
	hinge("BoomHinge", cab, boom, cf * CFrame.new(P1.Position), { -45, 30 }, 0.6)
	hinge("StickHinge", boom, stick, cf * CFrame.new(E1.Position), { -60, 55 }, 0.8)
	hinge("BucketHinge", stick, bucket, cf * CFrame.new(E2.Position), { -80, 70 }, 1.0)
	return cab
end

local function build(id, def, cf, player, fuel, condition)
	local model = Instance.new("Model"); model.Name = player.Name .. "_" .. id
	local s = def.size
	local body = part(model, "Body", s, cf, def.color)
	body.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0, 0, 100, 1)
	model.PrimaryPart = body

	local seat = Instance.new("VehicleSeat")
	seat.Name = "Seat"; seat.Size = Vector3.new(2, 1, 2); seat.MaxSpeed = 0; seat.Torque = 0
	seat.CFrame = cf * CFrame.new(0, s.Y / 2 + 0.5, s.Z * 0.1)
	seat.Parent = model
	if def.construction then
		local cab = buildExcavator(model, body, cf, s, def)
		seat.CFrame = cf * CFrame.new(-2.2, s.Y / 2 + 1.5, -2.2) -- inside the operator cab
		weld(cab, seat)
	else
		weld(body, seat)
	end

	local wheelSize = Vector3.new(1.5, 2.2, 2.2)
	for _, x in (def.construction and {} or { -s.X / 2, s.X / 2 }) do
		for _, z in { -s.Z / 2 + 2, s.Z / 2 - 2 } do
			local w = part(model, "Wheel", wheelSize, cf * CFrame.new(x, -s.Y / 2 + 0.2, z) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(25, 25, 25), false)
			w.Shape = Enum.PartType.Cylinder; weld(body, w)
		end
	end
	local att = Instance.new("Attachment"); att.Parent = body
	local drive = Instance.new("LinearVelocity")
	drive.Name = "Drive"; drive.Attachment0 = att; drive.RelativeTo = Enum.ActuatorRelativeTo.World
	drive.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	drive.PrimaryTangentAxis = Vector3.xAxis; drive.SecondaryTangentAxis = Vector3.zAxis
	drive.PlaneVelocity = Vector2.zero; drive.Parent = body
	local turn = Instance.new("AngularVelocity")
	turn.Name = "Turn"; turn.Attachment0 = att; turn.RelativeTo = Enum.ActuatorRelativeTo.World
	turn.AngularVelocity = Vector3.zero; turn.Parent = body

	model.Parent = workspace
	local mass = body.AssemblyMass
	drive.MaxForce = mass * 60 -- horizontal only; gravity is untouched in Plane mode
	turn.MaxTorque = mass * 4000

	seat:SetAttribute("VehicleId", id)
	seat:SetAttribute("OwnerUserId", player.UserId)
	seat:SetAttribute("MaxSpeed", def.maxSpeed)
	seat:SetAttribute("TurnRate", def.turnRate)
	seat:SetAttribute("Fuel", fuel)
	seat:SetAttribute("FuelCapacity", def.fuelCapacity)
	seat:SetAttribute("Condition", condition)
	seat:SetAttribute("Disabled", fuel <= 0)
	seat:SetAttribute("Construction", def.construction == true)
	seat:SetAttribute("Load", 0)

	-- prompt so the owner can get in without having to climb onto the seat
	Interaction.Register(seat, { action = "Drive", object = def.name, distance = 12, onTriggered = function(p)
		local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
		if p == player and hum and not seat.Occupant then seat:Sit(hum) end
	end })

	-- only the owner may drive
	seat:GetPropertyChangedSignal("Occupant"):Connect(function()
		local hum = seat.Occupant
		if not hum then return end
		local occupant = Players:GetPlayerFromCharacter(hum.Parent)
		if occupant ~= player then
			task.defer(function() hum.Sit = false; hum.Jump = true end)
			if occupant then Notify.Send(occupant, "This is " .. player.Name .. "'s vehicle", "error") end
		end
	end)
	return model, body, seat
end

local function spawnCFrame(player)
	local sp = workspace:FindFirstChild("VehicleSpawn", true)
	if sp and sp:IsA("BasePart") then return sp.CFrame * CFrame.new(0, 4, 0) end
	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then return nil end
	return CFrame.new(hrp.Position + hrp.CFrame.LookVector * 14 + Vector3.new(0, 4, 0), hrp.Position + hrp.CFrame.LookVector * 30)
end

function V.Despawn(player: Player)
	local a = active[player]
	if not a then return end
	active[player] = nil
	local d = DataService.Get(player)
	if d and d.vehicles[a.id] then d.vehicles[a.id].fuel = a.fuel; d.vehicles[a.id].condition = a.condition end
	a.model:Destroy()
end

function V.Spawn(player: Player, id: string): boolean
	local d, def = DataService.Get(player), Defs[id]
	if not d or not def or not d.vehicles[id] then return false end
	V.Despawn(player)
	local cf = spawnCFrame(player)
	if not cf then return false end
	local rec = d.vehicles[id]
	local model, body, seat = build(id, def, cf, player, rec.fuel, rec.condition)
	active[player] = { id = id, model = model, body = body, seat = seat, fuel = rec.fuel, condition = rec.condition }
	Notify.Send(player, def.name .. " ready", "success")
	return true
end

function V.GetActive(player: Player)
	return active[player]
end

function V.Buy(player: Player, id: string): boolean
	local d, def = DataService.Get(player), Defs[id]
	if not d or not def then return false end
	if d.vehicles[id] then Notify.Send(player, "You already own a " .. def.name, "error"); return false end
	if not Economy.SpendCash(player, def.price) then Notify.Send(player, "Need $" .. def.price, "error"); return false end
	d.vehicles[id] = { fuel = def.fuelCapacity, condition = 100 }
	DataService.Push(player)
	Notify.Send(player, "Bought " .. def.name, "success")
	return true
end

local function near(a, station, range)
	return a and (a.body.Position - station.Position).Magnitude <= range
end

local function refuel(player, station)
	local a = active[player]
	if not near(a, station, Config.VehicleServiceRange) then Notify.Send(player, "Bring your vehicle to the pump", "error"); return end
	local cap = Defs[a.id].fuelCapacity
	local want = math.ceil(cap - a.fuel)
	local d = DataService.Get(player)
	if want <= 0 or not d then Notify.Send(player, "Tank is full", "info"); return end
	local units = math.min(want, math.floor(d.cash / Config.FuelPricePerUnit))
	if units <= 0 or not Economy.SpendCash(player, units * Config.FuelPricePerUnit) then Notify.Send(player, "Not enough cash", "error"); return end
	a.fuel = math.min(cap, a.fuel + units)
	a.seat:SetAttribute("Fuel", a.fuel); a.seat:SetAttribute("Disabled", false)
	Notify.Send(player, "Refuelled: $" .. units * Config.FuelPricePerUnit, "success")
end

local function repair(player, station)
	local a = active[player]
	if not near(a, station, Config.VehicleServiceRange) then Notify.Send(player, "Bring your vehicle to the garage", "error"); return end
	local missing = 100 - a.condition
	local cost = math.ceil(missing * Config.RepairPricePerPoint)
	if cost <= 0 then Notify.Send(player, "No repairs needed", "info"); return end
	if not Economy.SpendCash(player, cost) then Notify.Send(player, "Repairs cost $" .. cost, "error"); return end
	a.condition = 100
	a.seat:SetAttribute("Condition", 100)
	Notify.Send(player, "Repaired: $" .. cost, "success")
end

local function hook(inst: Instance)
	if not inst:IsA("BasePart") then return end
	local garageId = inst.Name:match("^VehicleGarage_(.+)$")
	local shopId = inst.Name:match("^VehicleShop_(.+)$")
	if garageId and Defs[garageId] then
		Interaction.Register(inst, { action = "Take out / store", object = Defs[garageId].name, onTriggered = function(p)
			local a = active[p]
			if a and a.id == garageId then V.Despawn(p); Notify.Send(p, "Vehicle stored", "info")
			elseif not V.Spawn(p, garageId) then Notify.Send(p, "You don't own a " .. Defs[garageId].name, "error") end
		end })
	elseif shopId and Defs[shopId] then
		Interaction.Register(inst, { action = "Buy $" .. Defs[shopId].price, object = Defs[shopId].name, onTriggered = function(p) V.Buy(p, shopId) end })
	elseif inst.Name == "FuelStation" then
		Interaction.Register(inst, { action = "Refuel", object = "Fuel Pump", onTriggered = function(p) refuel(p, inst) end })
	elseif inst.Name == "Garage_Repair" then
		Interaction.Register(inst, { action = "Repair", object = "Mechanic", onTriggered = function(p) repair(p, inst) end })
	end
end

function V.Start()
	for _, d in workspace:GetDescendants() do hook(d) end
	workspace.DescendantAdded:Connect(hook)
	Players.PlayerRemoving:Connect(V.Despawn)
	-- one loop for every vehicle: fuel use and wear only while moving with a driver
	task.spawn(function()
		while true do
			task.wait(1)
			for player, a in active do
				if not a.model.Parent then active[player] = nil; continue end
				local def = Defs[a.id]
				if a.seat.Occupant and a.body.AssemblyLinearVelocity.Magnitude > 2 then
					a.fuel = math.max(0, a.fuel - def.fuelPerSecond)
					a.condition = math.max(0, a.condition - def.wearPerSecond)
					a.seat:SetAttribute("Fuel", a.fuel); a.seat:SetAttribute("Condition", a.condition)
					a.seat:SetAttribute("Disabled", a.fuel <= 0)
					local d = DataService.Get(player)
					if d and d.vehicles[a.id] then d.vehicles[a.id].fuel = a.fuel; d.vehicles[a.id].condition = a.condition end
				end
			end
		end
	end)
end

return V
]]></ProtectedString></Properties></Item></Item><Item class="Script" referent="RBX32"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[local Systems = script.Parent:WaitForChild("Systems")
require(game.ReplicatedStorage.Shared.Remotes) -- create remotes first

-- Start each system on its own so one failure can't stop the rest; failures are named in Output.
local ORDER = { "DataService", "TestWorld", "MallService", "JobCentre", "PizzaService", "VehicleService", "ExcavatorService", "ShopService", "FoodService" }
for _, name in ORDER do
	local ok, err = pcall(function() require(Systems[name]).Start() end)
	if not ok then warn("[Harbourlife] " .. name .. " failed to start: " .. tostring(err)) end
end
print("[Harbourlife] server started")
]]></ProtectedString></Properties></Item></Item><Item class="StarterPlayer" referent="RBX38"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX37"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX34"><Properties><string name="Name">HUD</string><ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local Remotes = require(game.ReplicatedStorage.Shared.Remotes)

local gui = Instance.new("ScreenGui")
gui.Name = "HarbourlifeHUD"; gui.ResetOnSpawn = false
gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

local money = Instance.new("TextLabel")
money.Size = UDim2.fromOffset(340, 32); money.Position = UDim2.new(1, -350, 0, 10)
money.BackgroundTransparency = 0.4; money.BackgroundColor3 = Color3.new(0, 0, 0)
money.TextColor3 = Color3.new(1, 1, 1); money.Font = Enum.Font.GothamBold; money.TextSize = 16
money.Text = "Cash: ..."; money.Parent = gui

local toast = Instance.new("TextLabel")
toast.Size = UDim2.fromOffset(320, 36); toast.Position = UDim2.new(0.5, -160, 0, 20)
toast.BackgroundTransparency = 0.3; toast.BackgroundColor3 = Color3.new(0, 0, 0)
toast.TextColor3 = Color3.new(1, 1, 1); toast.Font = Enum.Font.Gotham; toast.TextSize = 16
toast.Visible = false; toast.Parent = gui

Remotes.DataChanged.OnClientEvent:Connect(function(d)
	money.Text = string.format("Lv %d | Cash $%d | Bank $%d | %s", d.level, d.cash, d.bank, d.job)
end)

local token = 0
Remotes.Notify.OnClientEvent:Connect(function(text)
	token += 1; local mine = token
	toast.Text = text; toast.Visible = true
	task.delay(3, function() if token == mine then toast.Visible = false end end)
end)

-- Inventory panel: press I
local Items = require(game.ReplicatedStorage.Shared.ItemDefinitions)
local UIS = game:GetService("UserInputService")
local panel = Instance.new("TextLabel")
panel.Size = UDim2.fromOffset(240, 260); panel.Position = UDim2.new(0, 10, 0.5, -130)
panel.BackgroundTransparency = 0.3; panel.BackgroundColor3 = Color3.new(0, 0, 0)
panel.TextColor3 = Color3.new(1, 1, 1); panel.Font = Enum.Font.Gotham; panel.TextSize = 16
panel.TextXAlignment = Enum.TextXAlignment.Left; panel.TextYAlignment = Enum.TextYAlignment.Top
panel.Visible = false; panel.Parent = gui

local lastData
local function render()
	if not lastData then return end
	local lines = { "INVENTORY (I to close)" }
	for id, n in lastData.inventory do
		table.insert(lines, string.format("%s x%d", Items[id] and Items[id].name or id, n))
	end
	table.insert(lines, "")
	table.insert(lines, "SKILLS")
	for id, s in lastData.skills do table.insert(lines, string.format("%s Lv %d", id, s.level)) end
	table.insert(lines, string.format("Reputation: %d", lastData.reputation or 0))
	panel.Text = table.concat(lines, "\n")
end
Remotes.DataChanged.OnClientEvent:Connect(function(d) lastData = d; render() end)
UIS.InputBegan:Connect(function(input, processed)
	if not processed and input.KeyCode == Enum.KeyCode.I then panel.Visible = not panel.Visible; render() end
end)

-- Vehicle gauge (reads attributes the server keeps on the seat)
local gauge = Instance.new("TextLabel")
gauge.Size = UDim2.fromOffset(330, 54); gauge.Position = UDim2.new(1, -340, 0, 48)
gauge.BackgroundTransparency = 0.4; gauge.BackgroundColor3 = Color3.new(0, 0, 0)
gauge.TextColor3 = Color3.new(1, 1, 1); gauge.Font = Enum.Font.GothamBold; gauge.TextSize = 15
gauge.Visible = false; gauge.Parent = gui
game:GetService("RunService").Heartbeat:Connect(function()
	local hum = Players.LocalPlayer.Character and Players.LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
	local seat = hum and hum.SeatPart
	if seat and seat:IsA("VehicleSeat") and seat:GetAttribute("VehicleId") then
		gauge.Visible = true
		local txt = string.format("Fuel %d/%d | Condition %d%%", seat:GetAttribute("Fuel") or 0, seat:GetAttribute("FuelCapacity") or 0, seat:GetAttribute("Condition") or 0)
		if seat:GetAttribute("Construction") then
			txt ..= string.format(" | Load %d\nQE swing  RF boom  TG stick  YH bucket  hold X dig  hold Z dump", seat:GetAttribute("Load") or 0)
		end
		gauge.Text = txt
	else
		gauge.Visible = false
	end
end)
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX35"><Properties><string name="Name">ShopUI</string><ProtectedString name="Source"><![CDATA[-- Shop window. The server sends the item list; buying only sends a request, the server decides.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Remotes = require(game.ReplicatedStorage.Shared.Remotes)
local player = Players.LocalPlayer

local gui = Instance.new("ScreenGui")
gui.Name = "ShopUI"; gui.ResetOnSpawn = false; gui.Enabled = false
gui.Parent = player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.fromOffset(420, 400); frame.Position = UDim2.new(0.5, -210, 0.5, -200)
frame.BackgroundColor3 = Color3.fromRGB(25, 30, 40); frame.BackgroundTransparency = 0.05; frame.Parent = gui
Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 10)

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -60, 0, 44); title.Position = UDim2.fromOffset(14, 0)
title.BackgroundTransparency = 1; title.TextXAlignment = Enum.TextXAlignment.Left
title.Font = Enum.Font.GothamBold; title.TextSize = 20; title.TextColor3 = Color3.new(1, 1, 1); title.Parent = frame

local close = Instance.new("TextButton")
close.Size = UDim2.fromOffset(36, 36); close.Position = UDim2.new(1, -44, 0, 4)
close.Text = "X"; close.Font = Enum.Font.GothamBold; close.TextSize = 18
close.BackgroundColor3 = Color3.fromRGB(170, 50, 50); close.TextColor3 = Color3.new(1, 1, 1); close.Parent = frame
Instance.new("UICorner", close)

local list = Instance.new("ScrollingFrame")
list.Size = UDim2.new(1, -20, 1, -54); list.Position = UDim2.fromOffset(10, 48)
list.BackgroundTransparency = 1; list.ScrollBarThickness = 6
list.AutomaticCanvasSize = Enum.AutomaticSize.Y; list.CanvasSize = UDim2.new()
list.Parent = frame
local layout = Instance.new("UIListLayout"); layout.Padding = UDim.new(0, 6); layout.Parent = list

local current
local openedAt: Vector3?

local function row(shopId, it)
	local r = Instance.new("Frame")
	r.Size = UDim2.new(1, -8, 0, 44); r.BackgroundColor3 = Color3.fromRGB(45, 52, 66); r.Parent = list
	Instance.new("UICorner", r).CornerRadius = UDim.new(0, 6)
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, -100, 1, 0); label.Position = UDim2.fromOffset(10, 0); label.BackgroundTransparency = 1
	label.TextXAlignment = Enum.TextXAlignment.Left; label.Font = Enum.Font.Gotham; label.TextSize = 15
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Text = string.format("%s   $%d   (stock %d)", it.name, it.price, it.stock); label.Parent = r
	local b = Instance.new("TextButton")
	b.Size = UDim2.fromOffset(80, 32); b.Position = UDim2.new(1, -88, 0.5, -16)
	b.Font = Enum.Font.GothamBold; b.TextSize = 15; b.TextColor3 = Color3.new(1, 1, 1)
	b.Text = it.stock > 0 and "Buy" or "Sold out"
	b.BackgroundColor3 = it.stock > 0 and Color3.fromRGB(40, 150, 80) or Color3.fromRGB(90, 90, 90)
	b.AutoButtonColor = it.stock > 0; b.Parent = r
	Instance.new("UICorner", b)
	b.Activated:Connect(function()
		if it.stock > 0 then Remotes.ShopBuy:FireServer(shopId, it.id, 1) end
	end)
end

Remotes.OpenShop.OnClientEvent:Connect(function(data)
	current = data.id
	title.Text = data.name
	for _, c in list:GetChildren() do if c:IsA("Frame") then c:Destroy() end end
	for _, it in data.items do row(data.id, it) end
	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not gui.Enabled then openedAt = hrp and hrp.Position end
	gui.Enabled = true
end)

close.Activated:Connect(function() gui.Enabled = false; current = nil end)

-- close when the player walks away from the counter
RunService.Heartbeat:Connect(function()
	if not gui.Enabled or not openedAt then return end
	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not hrp or (hrp.Position - openedAt).Magnitude > 18 then gui.Enabled = false; current = nil end
end)
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX36"><Properties><string name="Name">VehicleDriver</string><ProtectedString name="Source"><![CDATA[-- Drives the vehicle the local player is seated in. The server built the constraints
-- (Drive / Turn); the driver's client owns the physics so steering feels instant.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local Remotes = require(game.ReplicatedStorage.Shared.Remotes)
local player = Players.LocalPlayer

-- Excavator controls (hold): Q/E swing, R/F boom, T/G stick, Y/H bucket. Hold: X dig, Z dump.
local JOINTS = {
	{ name = "SwingHinge", up = Enum.KeyCode.Q, down = Enum.KeyCode.E, rate = 50 },
	{ name = "BoomHinge", up = Enum.KeyCode.R, down = Enum.KeyCode.F, rate = 30, min = -45, max = 30 },
	{ name = "StickHinge", up = Enum.KeyCode.T, down = Enum.KeyCode.G, rate = 35, min = -60, max = 55 },
	{ name = "BucketHinge", up = Enum.KeyCode.Y, down = Enum.KeyCode.H, rate = 50, min = -80, max = 70 },
}
local function driveArm(seat, dt)
	if UIS:GetFocusedTextBox() then return end
	local model = seat.Parent
	for _, j in JOINTS do
		local h = model:FindFirstChild(j.name, true)
		if h then
			local dir = (UIS:IsKeyDown(j.up) and 1 or 0) - (UIS:IsKeyDown(j.down) and 1 or 0)
			if dir ~= 0 then
				local t = h.TargetAngle + dir * j.rate * dt
				if j.min then t = math.clamp(t, j.min, j.max) end
				h.TargetAngle = t
			end
		end
	end
end
-- Hold X to keep digging, hold Z to keep dumping (the server enforces the real rate).
local lastAction = 0
local function armActions(seat)
	if UIS:GetFocusedTextBox() or os.clock() - lastAction < 0.65 then return end
	if UIS:IsKeyDown(Enum.KeyCode.X) then lastAction = os.clock(); Remotes.ExcavatorAction:FireServer("dig")
	elseif UIS:IsKeyDown(Enum.KeyCode.Z) then lastAction = os.clock(); Remotes.ExcavatorAction:FireServer("dump") end
end

RunService.RenderStepped:Connect(function(dt)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local seat = hum and hum.SeatPart
	if not (seat and seat:IsA("VehicleSeat") and seat:GetAttribute("VehicleId")) then return end
	if seat:GetAttribute("OwnerUserId") ~= player.UserId then return end
	local body = seat.Parent and seat.Parent.PrimaryPart
	local drive = body and body:FindFirstChild("Drive")
	local turn = body and body:FindFirstChild("Turn")
	if not (drive and turn) then return end

	if seat:GetAttribute("Construction") then driveArm(seat, dt); armActions(seat) end
	local maxSpeed = seat:GetAttribute("MaxSpeed") or 0
	local condition = seat:GetAttribute("Condition") or 100
	if seat:GetAttribute("Disabled") then maxSpeed = 0 end
	if condition < 25 then maxSpeed *= 0.6 end -- badly worn vehicles are slower

	local look = body.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	flat = flat.Magnitude > 0.01 and flat.Unit or Vector3.zero
	local vel = Vector3.new(body.AssemblyLinearVelocity.X, 0, body.AssemblyLinearVelocity.Z)
	local forwardSpeed = vel:Dot(flat)

	local target = seat.ThrottleFloat * maxSpeed
	drive.PlaneVelocity = Vector2.new(flat.X * target, flat.Z * target)

	local grip = math.clamp(math.abs(forwardSpeed) / 8, 0, 1) * (forwardSpeed >= 0 and 1 or -1)
	turn.AngularVelocity = Vector3.new(0, -seat.SteerFloat * (seat:GetAttribute("TurnRate") or 1.5) * grip, 0)
end)
]]></ProtectedString></Properties></Item></Item></Item></roblox>